local function stateValue(value, depth)
depth = (depth or 0) + 1
if depth > 3 then
return nil
end
if type(value) == "boolean" then
return value
end
if type(value) == "string" then
local s = value:lower()
if s == "active"
or s == "alive"
or s == "fight"
or s == "fighting"
or s == "spawned"
or s == "combat" then
return true
end
if s == "dead"
or s == "inactive"
or s == "despawned"
or s == "waiting"
or s == "idle" then
return false
end
end
if type(value) == "table" then
for _, k in ipairs({
"Spawned",
"Alive",
"IsAlive",
"Active",
"IsActive"
}) do
if type(value[k]) == "boolean" then
return value[k]
end
end
for _, k in ipairs({
"Mode",
"Status",
"State",
"Phase"
}) do
if value[k] ~= value then
local found = stateValue(
value[k],
depth
)
if found ~= nil then
return found
end
end
end
end
return nil
end
local function onBossState(data)
    if type(data) ~= "table" then
        if bossTimer.synced then return end
        local state = stateValue(data)
        if state == true then
            updateBossPresence(true)
        elseif state == false then
            updateBossPresence(false)
        end
        return
    end

    -- Server-authored State:Observe payload.
    if type(data.Phase) == "string" then
        local phase = data.Phase
        if phase ~= "Warning" and phase ~= "Fight"
            and phase ~= "Defeated" and phase ~= "Escaped" then
            phase = "Idle"
        end

        local fightId = data.FightId
        bossTimer.synced = true
        bossTimer.phase = phase
        bossTimer.startsAt = tonumber(data.StartsAt)
        bossTimer.endsAt = tonumber(data.EndsAt)
        bossTimer.fightId = fightId

        if phase == "Fight" then
            -- Ignore stale Fight updates for the same already-defeated boss.
            if bossTimer.deadLock
                and (fightId == bossTimer.deadFightId
                    or fightId == nil) then
                updateBossPresence(false)
            else
                bossTimer.deadLock = false
                defeated = false
                defeatedModel = nil
                bossState = true
                bossStateAt = os.clock()
                local hp = tonumber(data.Health)
                if hp and hp <= 0 then
                    recordDeath()
                else
                    updateBossPresence(true)
                end
            end
        elseif phase == "Defeated" or phase == "Escaped" then
            recordDeath()
            updateBossPresence(false)
        else
            -- Warning/Idle: don't fight or hover until Phase == Fight.
            if phase == "Warning" then
                bossTimer.deadLock = false
            end
            updateBossPresence(false)
        end
        bossTimer.render()
        return
    end

    -- Backward-compatible fallback only before a real phase subscription.
    if bossTimer.synced then return end
    local state = stateValue(data)
    if state == true then
        updateBossPresence(true)
    elseif state == false then
        updateBossPresence(false)
    end
end
local function onBossHit(data)
if bossTimer.synced and bossTimer.phase ~= "Fight" then return end
if type(data) ~= "table" then
return
end
local health = tonumber(data.Health)
if health and health <= 0 then
recordDeath()
return
end
if health and health > 0 then
if bossTimer.deadLock then return end
if defeated and os.clock() - bossStateAt < 2 then
return
end
if defeated then
defeated = false
defeatedModel = nil
end
lastCombatAt = os.clock()
updateBossPresence(true)
