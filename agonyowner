-- V11.9.71: Cloud-phone mouse-wheel fallback. Native touch and native wheel
-- scrolling remain enabled. Only synthesize a canvas move if Roblox did not
-- already scroll the intended frame. A visible dropdown takes priority.
do
    local queued = {}
    local function contains(obj, pos)
        local a, size = obj.AbsolutePosition, obj.AbsoluteSize
        return pos.X >= a.X and pos.X < a.X + size.X
            and pos.Y >= a.Y and pos.Y < a.Y + size.Y
    end
    local function visibleAt(obj, pos)
        if not obj.Visible or not contains(obj, pos) then return false end
        local parent = obj.Parent
        while parent and parent ~= window do
            if parent:IsA("GuiObject") then
                if not parent.Visible or ((parent.ClipsDescendants or parent:IsA("ScrollingFrame"))
                    and not contains(parent, pos)) then return false end
            end
            parent = parent.Parent
        end
        return parent == window and window.Visible
    end
    local function maxScroll(frame)
        -- These canvases are offset-based. Use the viewport in local UI
        -- units so the fallback also works on the scaled mobile window.
        local factor = math.max(scale.Scale, 0.01)
        local viewport = frame.AbsoluteWindowSize.Y / factor
        local canvas = frame.CanvasSize.Y.Offset + frame.CanvasSize.Y.Scale * viewport
        return math.max(0, canvas - viewport)
    end
    local function scrollTarget(pos)
        -- The dropdown is a sibling overlay, not a child of its source page.
        for i = #menuFrames, 1, -1 do
            local m = menuFrames[i]
            if visibleAt(m, pos) then return m end
        end
        local best, depth = nil, -1
        for _, obj in ipairs(window:GetDescendants()) do
            if obj:IsA("ScrollingFrame") and obj.ScrollingEnabled and visibleAt(obj, pos) then
                local n, parent = 0, obj.Parent
                while parent and parent ~= window do n += 1; parent = parent.Parent end
                if n > depth and maxScroll(obj) > 0 then best, depth = obj, n end
            end
        end
        return best
    end
    on(UIS.InputChanged, function(input)
        if not alive or not window.Visible or input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
        local delta = input.Position.Z
        if delta == 0 then delta = input.Delta.Z end
        if delta == 0 then return end
        local pos = UIS:GetMouseLocation()
        if not contains(window, pos) then
            pos = Vector2.new(input.Position.X, input.Position.Y)
            if not contains(window, pos) then return end
        end
        local frame = scrollTarget(pos)
        if not frame or maxScroll(frame) <= 0 then return end
        local existing = queued[frame]
        if existing then existing.delta += delta; return end
        local record = {old = frame.CanvasPosition.Y, delta = delta}
        queued[frame] = record
        task.spawn(function()
            Run.Heartbeat:Wait()
            Run.Heartbeat:Wait()
            if queued[frame] ~= record then return end
            queued[frame] = nil
            if not alive or not frame.Parent or not window.Visible or not frame.Visible then return end
            if not visibleAt(frame, pos) then return end
            if math.abs(frame.CanvasPosition.Y - record.old) > 0.5 then return end
            local y = math.clamp(record.old - record.delta * 48, 0, maxScroll(frame))
            frame.CanvasPosition = Vector2.new(frame.CanvasPosition.X, y)
        end)
    end)
end
