                count += 1
                local petName = clean(record.Name or catalogName or record.BaseName or record.PetName,
                    "Unknown Secret Pet", 80)
                rarity = clean(rarity, "Secret", 24)
                local tier = clean(record.Tier, "Normal", 32)
                local mutation = clean(record.Mutation, "", 32)
                local key = table.concat({petName, rarity, tier, mutation}, "\0")
                local group = groups[key]
                if group then group.count += 1
                else groups[key] = {name=petName,rarity=rarity,tier=tier,mutation=mutation,count=1} end
            end
        end
    end
    local all = {}
    for _, entry in pairs(groups) do table.insert(all, entry) end
    table.sort(all, function(a,b)
        if a.rarity ~= b.rarity then return a.rarity > b.rarity end
        if a.name ~= b.name then return a.name < b.name end
        if a.tier ~= b.tier then return a.tier < b.tier end
        return a.mutation < b.mutation
    end)
    -- The per-account HTTP request stays bounded to protect the free host.
    local truncated = #all > 400
    while #all > 400 do table.remove(all) end
    return count, all, truncated
end
local function secretCount()
    local count = secretSnapshot()
    return count
end

local lastReportedSecrets = nil
local sending = false
local lastSendAt = -math.huge
local function sendHeartbeat(refreshGeneration)
    if not active or sending then return false end
    sending = true
    local sender = getRequest()
    if not sender then
        sending = false
        warn("[AGONY OWNER] Executor HTTP request function unavailable")
        return false
    end
    local count, petList, truncated = secretSnapshot()
    local payload = {
        userId = player.UserId,
        username = player.Name,
        running = true,
        grinding = hubExecuted(), -- Successfully loaded via auto-execute = grinding, independent of farming toggles
        secretCount = count, -- nil means inventory unavailable: don't overwrite last valid count.
        secretPets = petList, -- grouped per-pet breakdown; nil if inventory unavailable
        secretPetsTruncated = truncated or false,
        refreshGeneration = refreshGeneration, -- command ID; server validates before counting an ACK
    }
    local ok, response = pcall(sender, {
        Url = API_URL, Method = "POST",
        Headers = { ["Content-Type"]="application/json", ["X-Agony-Key"]=API_KEY },
        Body = HttpService:JSONEncode(payload)
    })
    if not ok or type(response) ~= "table" then
        sending = false
        warn("[AGONY OWNER] Request failed:", response)
        return false
    end
    local code = tonumber(response.StatusCode or response.Status)
    local succeeded = code and code >= 200 and code < 300
    sending = false
    if succeeded then
        lastSendAt = os.clock()
        if count ~= nil then lastReportedSecrets = count end
    else
        warn("[AGONY OWNER] HTTP", tostring(code), tostring(response.Body or ""):sub(1,100))
    end
    return succeeded == true
end

-- V1.6: online-targeted, authenticated polling for owner dashboard refresh requests.
-- Each active client checks the command roughly once a minute; if it changes,
-- immediately POST an authoritative inventory snapshot, outside the 20-min schedule.
-- Clients cannot be pushed to directly by a normal PHP website.
local lastHandledRefresh = nil
local function pollRefreshCommand()
    if not active then return nil end
    local sender = getRequest()
    if not sender then return nil end
    local ok, response = pcall(sender, {
        Url = REFRESH_URL .. "?userId=" .. tostring(player.UserId), Method = "GET",
        Headers = { ["X-Agony-Key"] = API_KEY }
    })
    if not ok or type(response) ~= "table" then return nil end
    local status = tonumber(response.StatusCode or response.Status)
    if not status or status < 200 or status >= 300 then return nil end
    local decodedOk, body = pcall(function() return HttpService:JSONDecode(response.Body or "") end)
    if not decodedOk or type(body) ~= "table" or body.success ~= true then return nil end
    local generation = body.generation
    if type(generation) ~= "string" or #generation ~= 24 or generation == lastHandledRefresh then return nil end
    return generation
end

-- SecretEggFlash is broadcast globally. Remember local events for diagnostic purposes,
-- but do NOT send an extra HTTP request: next scheduled heartbeat reports the
-- authoritative inventory snapshot, including newly hatched/traded/deleted pets.
local pendingSecretHatches = 0
local function onSecretFlash(data)
    if not active or type(data) ~= "table" then return end
    if tonumber(data.UserId) ~= player.UserId then return end
    if secretRarity(data.Rarity) then pendingSecretHatches += 1 end
end

-- Only accounts whose full AGONY HUB successfully initialized are registered.
task.spawn(function()
    while active and not hubExecuted() do task.wait(2) end
    if not active then return end

    -- Give the initial replica a little time; missing data is not reported as 0.
    local deadline = os.clock() + 25
    while active and os.clock() < deadline do
        if secretCount() ~= nil then break end
        task.wait(1)
    end
    if not active then return end
    sendHeartbeat() -- one initial registration/update, no per-5-second polling

    task.spawn(function()
        local boundEvent
        while active do
            local event
            pcall(function()
                event = RS:FindFirstChild("RemoteServices")
                event = event and event:FindFirstChild("EggService")
                event = event and event:FindFirstChild("RE")
                event = event and event:FindFirstChild("SecretEggFlash")
            end)
            if event and not (event:IsA("RemoteEvent") or event:IsA("UnreliableRemoteEvent")) then event = nil end
            if event ~= boundEvent then
                if secretConnection then secretConnection:Disconnect(); secretConnection = nil end
                boundEvent = event
                if event then secretConnection = event.OnClientEvent:Connect(onSecretFlash) end
            end
            task.wait(15) -- finding the remote locally does not use hosting requests
        end
    end)

    local nextHeartbeat = os.clock() + HEARTBEAT_SECONDS
    local nextRefreshPoll = os.clock() + math.random(3, 15) -- stagger startup requests
    while active do
        if not hubExecuted() then stop(); break end
        local now = os.clock()
        if now >= nextRefreshPoll then
            nextRefreshPoll = now + REFRESH_POLL_SECONDS + math.random(0, 9)
            local generation = pollRefreshCommand()
            if generation and active then
                if sendHeartbeat(generation) then
                    lastHandledRefresh = generation
                    pendingSecretHatches = 0
                    nextHeartbeat = os.clock() + HEARTBEAT_SECONDS
                end
            end
        end
        if active and os.clock() >= nextHeartbeat then
            -- Same 20-minute heartbeat when no owner force-refresh is pending.
            if sendHeartbeat() then pendingSecretHatches = 0 end
            nextHeartbeat = os.clock() + HEARTBEAT_SECONDS
        end
        task.wait(2)
    end
end)

end

