            local nextEgg = eggSelected
            if nextEgg ~= target then
                target = nextEgg
                returnSettleUntil = 0
                lastReturnAt = -math.huge
                attempts = 0
                seenSuccesses = settingsUI.hatchWatch
                    and settingsUI.hatchWatch.successes or 0
                rearm(now, 1.4)
            end
            local allowed, islandReason = settingsUI.canHatchEgg(target)
            if not active() or target ~= eggSelected then return 0.5 end
            local paused = not allowed or busyMovement or hatchTradePaused()
                or (flags.boss and bossPresent)
            local native = settingsUI.nativeAutoEgg()
            if paused then
                if native and now - lastStopAt >= 1.5 then
                    lastStopAt = now
                    pcall(settingsUI.nativeAutoStop)
                end
                wasPaused = true
                eggStatus.Text = not allowed and islandReason or "PAUSED (BOSS/TRADE/MOVING)"
                return 0.5
            end
            if wasPaused then
                wasPaused = false
                attempts = 0
                rearm(now, 2.0)
            end

            -- When the player changes the selected egg, stop the old native
            -- session first. Never toggle while another egg is still active.
            if native and native ~= target then
                if now - lastStopAt >= 1.5 then
                    lastStopAt = now
                    pcall(settingsUI.nativeAutoStop)
                end
                restartAfter = math.max(restartAfter, now + 1.5)
                eggStatus.Text = "SWITCHING EGG"
                return 0.5
            end

            local root, hum = currentRoot(), currentHum()
            local stand = eggStand(target)
            if not root or not hum or hum.Health <= 0 or not stand then
                eggStatus.Text = "WAITING FOR CHARACTER/EGG"
                return 0.6
            end
            -- Restore stable measured landing. Don't reset Auto F for normal
            -- settling, animation or slight drift. Once native hatch is active,
            -- let its own range logic handle small movement. If it stops, the
            -- tighter start radius brings us back without a teleport loop.
            local displacement = root.Position - stand.Position
            local horizontal = Vector3.new(displacement.X, 0, displacement.Z).Magnitude
            local limit = native == target and (target == "Wild West" and 12 or 18) or (target == "Wild West" and 8 or 9)
            local far = horizontal > limit or math.abs(displacement.Y) > 14
            if far and now >= returnSettleUntil and now - lastReturnAt >= 4 then
                if not active() or settingsUI.islandBuyPriority() or busyMovement or hatchTradePaused() or (flags.boss and bossPresent) then return 0.5 end
                -- Never interrupt a current hatch/reveal just to correct a
                -- modest position difference; a truly distant player can return.
                if native == target and settingsUI.nativeAutoBusy() and horizontal < 35 and math.abs(displacement.Y) < 35 then
                    return 0.5
                end
                lastReturnAt = now
                local ok = pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.CFrame = stand
                end)
                if ok then
                    returnSettleUntil = now + 4
                    rearm(now, 1.5)
                end
                eggStatus.Text = "RETURNING TO " .. target
                return 0.5
            end
            -- During the post-teleport settling window, continue through to
            -- native start rather than endlessly returning before it can run.
            -- If the character is genuinely far away, wait for a retry.
            if horizontal > 35 or math.abs(displacement.Y) > 35 then
                eggStatus.Text = "WAITING TO RETURN"
                return 0.5
            end

            local watch = settingsUI.hatchWatch
            if watch and watch.successes ~= seenSuccesses then
                seenSuccesses = watch.successes
                if watch.egg == target and watch.lastSuccessAt > lastProgressAt then
                    lastProgressAt = watch.lastSuccessAt
                    attempts = 0
                    forceStop = false
                end
            end

            -- Respect server restrictions rather than restart-spamming when
            -- coins/storage are insufficient. Check again as they recover.
            local blocked = settingsUI.hatchPrerequisites(target)
            if not active() or settingsUI.islandBuyPriority() or busyMovement or hatchTradePaused() or (flags.boss and bossPresent) then return 0.25 end
            if blocked then
                if native == target then lastProgressAt = now end
                eggStatus.Text = blocked == "COINS"
                    and "WAITING FOR COINS" or "STORAGE FULL"
                return 1.0
            end
            local holdUntil = workspace:GetAttribute("TS2AutoOpenHeldUntil")
            local gameHolding = type(holdUntil) == "number"
                and workspace:GetServerTimeNow() < holdUntil
            local gameSaving = workspace:GetAttribute("PersistenceCritical") == true
            if gameHolding or gameSaving then
                lastProgressAt = now
                eggStatus.Text = gameSaving and "WAITING FOR SERVER"
                    or "WAITING FOR HATCH HOLD"
                return 0.8
            end

            if native == target then
                if not wasNative then
                    -- Start the stale-progress timer when Auto F is confirmed,
                    -- not when a start request was merely accepted by pcall.
                    lastProgressAt = now
                end
                wasNative = true
                settingsUI.nativePending = false
                -- Only use hatch packets as a progress signal if this remote
                -- is connected. Otherwise native state keeps normal Auto F on.
                if watch and watch.listening then
                    local busy = settingsUI.nativeAutoBusy()
                    local stallTime = busy and 100 or 42
                    if now - lastProgressAt >= stallTime
                        and now - lastStopAt >= 10 then
                        -- Confirm a real stall before stopping; give the game
                        -- secret-reveal/cutscene handling more time if busy.
                        forceStop = true
                    end
                end
                if forceStop then
                    forceStop = false
                    lastStopAt = now
                    local ok, stopped = pcall(settingsUI.nativeAutoStop)
                    if ok and stopped then
                        attempts = math.min(5, attempts + 1)
                        rearm(now, math.max(2, backoff()))
                        eggStatus.Text = "WATCHDOG RESTARTING " .. target
                    else
                        eggStatus.Text = "WATCHDOG WAITING TO STOP"
                    end
                else
                    eggStatus.Text = "AUTO HATCH WATCHING: " .. target
                end
                return 0.5
            end

            -- Native controller no longer says Auto F is on. Always re-arm,
            -- even if it previously ran for hours or failed the first start.
            if wasNative then
                wasNative = false
                attempts = 0
                restartAfter = math.max(restartAfter, now + 2)
                lastProgressAt = now
            end
            if settingsUI.nativeStopQueued then
                eggStatus.Text = "WAITING FOR PREVIOUS STOP"
                return 0.45
            end
            if settingsUI.nativeAutoBusy() then
                eggStatus.Text = "FINISHING PREVIOUS HATCH"
                return 0.65
            end
            if now < restartAfter then
                eggStatus.Text = "WATCHDOG WAITING: " .. target
                return 0.5
            end
            if now - lastRequestAt >= 2.5 then
                lastRequestAt = now
                local ok = settingsUI.nativeAutoStart(target)
                attempts = math.min(attempts + 1, 5)
                -- nativeAutoStart's pcall success does not guarantee the game
                -- enabled Auto F; the next tick must observe native == target.
                restartAfter = now + (ok and math.max(4, backoff())
                    or math.max(5, backoff()))
                eggStatus.Text = ok and ("START REQUEST: " .. target)
                    or ("RETRYING AUTO HATCH: " .. target)
            end
            return 0.5
        end

        while active() do
            local ok, interval = pcall(tick)
            if not ok then
                local now = os.clock()
                if now - workerLastWarn >= 15 then
                    workerLastWarn = now
                    warn("[AGONY AUTO HATCH] Watchdog recovered:",
                        tostring(interval):sub(1, 180))
                end
                interval = 1.0
            end
            task.wait(type(interval) == "number" and interval or 0.5)
        end
    end)
end
