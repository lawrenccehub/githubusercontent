-- The real game controller uses Comm.ClientComm:BuildObject().
-- It receives true phases using State:Observe, not a plain RemoteEvent.
local function attachCommBoss()
    if watched.commReady then return end
    local ok, service = pcall(function()
        local ClientComm = require(RS.Packages.Comm).ClientComm
        return ClientComm.new(
            RS.RemoteServices, false, "BlazingSovereignBossService"
        ):BuildObject()
    end)
    if not ok or not service or not service.State then return end
    local success, subscription = pcall(function()
        return service.State:Observe(function(data)
            if alive then onBossState(data) end
        end)
    end)
    if not success then
        warn("[AGONY BOSS STATE]", subscription)
        return
    end

    watched.commReady = true
    watched.commSubscription = subscription

    if service.Ended then
        local doneOk, doneConn = pcall(function()
            return service.Ended:Connect(function(data)
                if not alive then return end
                if type(data) == "table" then
                    local phase = tostring(data.Result or "")
                    if phase == "Defeated" or phase == "Escaped" then
                        bossTimer.phase = phase
                    end
                end
                recordDeath()
                bossTimer.render()
            end)
        end)
        if doneOk and doneConn then table.insert(conns, doneConn) end
    end
end

-- If State:Observe cannot connect, the already-running controller's
-- GetDebugState() still reports Phase and FightId.
local function fallbackControllerPhase()
    if watched.commReady then return end
    local ok, state = pcall(function()
        local controller = require(
            RS.Controllers.Game.BlazingSovereignBossController
        )
        return controller:GetDebugState()
    end)
    if ok and type(state) == "table"
        and type(state.Phase) == "string" then
        onBossState(state)
    end
end

