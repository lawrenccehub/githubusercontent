    local function normalize(name)
        return type(name)=="string" and name:lower():gsub("[^%w]", "") or ""
    end
    local function portalFor(target, world)
        local root=workspace
        if world=="TimeRift" then root=workspace:FindFirstChild("World2") end
        if not root then return nil end
        local wanted, alias = normalize(target.Name), normalize(target.PortalName)
        local candidates = {}
        for _, obj in ipairs(root:GetDescendants()) do
            if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
            if world=="Main" and obj:FindFirstAncestor("World2") then continue end
            local n=normalize(obj.Name)
            local a=normalize(obj:GetAttribute("Island"))
            local p=obj.Parent
            local inPortal=false
            for _=1,4 do
                if not p or p==root then break end
                if normalize(p.Name):find("portal",1,true) then inPortal=true; break end
                p=p.Parent
            end
            local named = n==wanted or (alias~="" and n==alias)
            local marked = n==wanted.."portal" or n=="portal"..wanted
                or (alias~="" and (n==alias.."portal" or n=="portal"..alias))
            if not (marked or (inPortal and named) or (a==wanted and (inPortal or n:find("portal",1,true)))) then continue end
            -- Only accept a real portal part, never an island/decor model pivot.
            local part=obj:IsA("BasePart") and obj or obj:FindFirstChild("Portal",true)
            if not (part and part:IsA("BasePart")) then
                part=obj:IsA("Model") and obj.PrimaryPart or nil
            end
            if part and part:IsA("BasePart") and part:IsDescendantOf(workspace) then candidates[part]=true end
        end
        local found
        for part in pairs(candidates) do
            if found then return nil end -- ambiguity: fail closed
            found=part
        end
        return found
    end
