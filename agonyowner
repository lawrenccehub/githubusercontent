    local function bindRiftSignals()
        if riftSignalsReady then return true end
        local entry = getRemote({"RemoteServices", "TimeRiftService", "RE", "EntryEncountered"}, "RemoteEvent")
        local result = getRemote({"RemoteServices", "TimeRiftService", "RE", "UnlockResult"}, "RemoteEvent")
        if not entry or not result then return false end
        on(entry.OnClientEvent, function(payload)
            if not alive or not enabled or type(payload) ~= "table" then return end
            if payload.Action == "Purchase" then
                riftEntryAt, riftEntryRoot = os.clock(), currentRoot()
                consolePrint("[AGONY AUTO BUY ISLAND] Time Rift purchase encounter received")
            elseif payload.Action == "Blocked" then
                clearRiftEntry()
                consoleWarn("[AGONY AUTO BUY ISLAND] Time Rift encounter blocked:", tostring(payload.Reason))
            end
        end)
        on(result.OnClientEvent, function(payload)
            if not alive or type(payload) ~= "table" then return end
            if pending and pending.Kind == "TimeRiftUnlock" then
                riftResult = payload
            end
        end)
        riftSignalsReady = true
        return true
    end
