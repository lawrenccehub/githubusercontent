-- V11.9.30: Hide ALL normal hatch visuals, including the 3 large eggs.
-- Some builds place the visible egg ViewportFrames outside Main, so hiding
-- only HatchScreen.Main is not enough. Hide every visible GuiObject inside
-- HatchScreen while a normal hatch is active, but restore everything for
-- secret reveals so Auto Hold / Reveal still works.
do
    local watchedHatch = nil
    local watchedConnections = {}
    local savedVisible = setmetatable({}, {__mode = "k"})
    local hiding = false

    local function disconnectAll()
        for _, c in ipairs(watchedConnections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(watchedConnections)
    end

    local function secretActive(gui)
        return gui and gui:GetAttribute("TS2SecretHatchActive") == true
    end

    local function restoreGuiObject(obj)
        local saved = savedVisible[obj]
        if saved == nil or not obj or not obj.Parent then return end
        hiding = true
        pcall(function()
            obj.Visible = saved
        end)
        hiding = false
        savedVisible[obj] = nil
    end

    local function restoreAll()
        for obj, _ in pairs(savedVisible) do
            restoreGuiObject(obj)
        end
    end

    local function clearWatch()
        disconnectAll()
        restoreAll()
        watchedHatch = nil
    end

    local function shouldHideObject(obj)
        if not obj or not obj.Parent then return false end
        if not obj:IsDescendantOf(pg) then return false end
        if not obj:IsA("GuiObject") then return false end
        -- Keep zero-sized / layout-only objects alone; only hide visible UI.
        if obj:IsA("UIListLayout") or obj:IsA("UIPadding") or obj:IsA("UIGridLayout")
            or obj:IsA("UIAspectRatioConstraint") or obj:IsA("UISizeConstraint")
            or obj:IsA("UITextSizeConstraint") then
            return false
        end
        return true
    end

    local function hideGuiObject(obj)
        if not shouldHideObject(obj) then return end
        if savedVisible[obj] == nil then
            local ok, current = pcall(function() return obj.Visible end)
            if ok then savedVisible[obj] = current end
        end
        local ok, current = pcall(function() return obj.Visible end)
        if ok and current then
            hiding = true
            pcall(function() obj.Visible = false end)
            hiding = false
        end
    end

    local function applyHide(gui)
        if not gui or not gui.Parent then return end
        for _, obj in ipairs(gui:GetDescendants()) do
            hideGuiObject(obj)
        end
        for _, obj in ipairs(gui:GetChildren()) do
            hideGuiObject(obj)
        end
    end

    local function bindGui(gui)
        if watchedHatch == gui then return end
        clearWatch()
        watchedHatch = gui

        table.insert(watchedConnections, gui:GetAttributeChangedSignal("TS2SecretHatchActive"):Connect(function()
            task.defer(function()
                if not watchedHatch or watchedHatch ~= gui then return end
                if secretActive(gui) then
                    restoreAll()
                elseif hideEggEnabled then
                    applyHide(gui)
                end
            end)
        end))

        table.insert(watchedConnections, gui.ChildAdded:Connect(function(child)
            if not hideEggEnabled or secretActive(gui) then return end
            task.defer(function()
                hideGuiObject(child)
                if child and child.Parent then
                    for _, obj in ipairs(child:GetDescendants()) do
                        hideGuiObject(obj)
                    end
                end
            end)
        end))

        table.insert(watchedConnections, gui.DescendantAdded:Connect(function(desc)
            if not hideEggEnabled or secretActive(gui) then return end
            task.defer(function() hideGuiObject(desc) end)
        end))

        table.insert(watchedConnections, gui.AncestryChanged:Connect(function(_, parent)
            if parent == nil then
                clearWatch()
            end
        end))
    end

    local function pickHatchGui()
        local hatch = pg:FindFirstChild("HatchScreen")
        if hatch and hatch:IsA("ScreenGui") then
            return hatch
        end
        return nil
    end

    -- The game's large eggs are in a SECOND ScreenGui, distinct from HatchScreen:
    -- PlayerGui > "Egg Opening Stuff" > Hatch_1, Hatch_2, Hatch_3.
    -- Hide only these visual containers; do not disable the whole GUI or the
    -- normal/secret renderer, which still needs to process server rewards.
    local watchedOpening = nil
    local openingRecords = {}
    local openingRootConnections = {}
    local openingChanging = false
    local openingSecretRestored = false

    local function restoreOpening()
        openingChanging = true
        for frame, record in pairs(openingRecords) do
            if frame and frame.Parent and record.original ~= nil then
                pcall(function() frame.Visible = record.original end)
            end
        end
        openingChanging = false
    end

    local function clearOpening()
        restoreOpening()
        for frame, record in pairs(openingRecords) do
            for _, connection in ipairs(record.connections) do
                pcall(function() connection:Disconnect() end)
            end
            openingRecords[frame] = nil
        end
        for _, connection in ipairs(openingRootConnections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(openingRootConnections)
        watchedOpening = nil
        openingSecretRestored = false
    end

    local function watchOpeningFrame(frame)
        if not frame or not frame:IsA("GuiObject") or openingRecords[frame] then
            return
        end
        if not frame.Name:match("^Hatch_[123]$") then
            return
        end
        local record = {original = frame.Visible, connections = {}}
        openingRecords[frame] = record
        -- Stop the normal hatch renderer from revealing the 3 big eggs again
        -- during its next animation tick, without polling every RenderStep.
        table.insert(record.connections,
            frame:GetPropertyChangedSignal("Visible"):Connect(function()
                if openingChanging or not alive or not hideEggEnabled then return end
                local hatch = pickHatchGui()
                if secretActive(hatch) then return end
                if frame.Visible then
                    openingChanging = true
                    pcall(function() frame.Visible = false end)
                    openingChanging = false
                end
            end))
        table.insert(record.connections,
            frame.AncestryChanged:Connect(function()
                if watchedOpening and frame:IsDescendantOf(watchedOpening) then return end
                local old = openingRecords[frame]
                if not old then return end
                for _, connection in ipairs(old.connections) do
                    pcall(function() connection:Disconnect() end)
                end
                openingRecords[frame] = nil
            end))
    end

    local function hideOpeningFrame(frame)
        if not frame or not frame:IsA("GuiObject") then return end
        watchOpeningFrame(frame)
        if frame.Visible then
            openingChanging = true
            pcall(function() frame.Visible = false end)
            openingChanging = false
        end
    end

    local function refreshOpening(secret)
        local opening = pg:FindFirstChild("Egg Opening Stuff")
            or pg:FindFirstChild("Egg Opening Stuff", true)
        if not opening or not opening.Parent then
            if watchedOpening then clearOpening() end
            return
        end
        if watchedOpening ~= opening then
            clearOpening()
            watchedOpening = opening
            table.insert(openingRootConnections,
                opening.DescendantAdded:Connect(function(obj)
                    if not alive or not hideEggEnabled or secretActive(pickHatchGui()) then return end
                    if obj:IsA("GuiObject") and obj.Name:match("^Hatch_[123]$") then
                        hideOpeningFrame(obj)
                    end
                end))
        end
        if secret then
            -- Restore at the start of the Secret reveal, then let the game
            -- own the frames until the reveal ends.
            if not openingSecretRestored then
                restoreOpening()
                openingSecretRestored = true
            end
            return
        end
        openingSecretRestored = false
        for i = 1, 3 do
            local frame = opening:FindFirstChild("Hatch_" .. i, true)
            if frame then hideOpeningFrame(frame) end
        end
    end

    -- V11.9.39: Hide the complete NORMAL hatch scene reported by Dex.
    -- The visible three egg models, white shockwave rings, beams/particles,
    -- and temporarily showcased pets live under Workspace.CurrentCamera:
    --   TS2HatchEgg_1 / _2 / _3
    --   TS2HatchShockwave, TS2HatchParticles_1 / _2 / _3
    --   TS2HatchGlobalEffects, TS2HatchBackdrop
    --   TS2HatchPet_<petname> and TS2PetGain_<n>
    -- Includes persistent shockwave rings, Emit()-spawned particles,
    -- lightning beams and temporary hatch pets.
    -- Changes are local and cosmetic only; no instances are destroyed,
    -- no HatchRenderer methods are replaced, and no hatch requests change.
    -- Secret renderers use their own scene (TS2SecretPet_*); leave it alone.
    -- Fully transparent particles rather than only Enabled=false:
    -- particles emitted with :Emit() can render even while Enabled=false.
    -- This keeps the NORMAL hatch scene invisible without destroying its
    -- objects or interfering with the server's hatch/reward processing.
    local HIDDEN_SEQUENCE = NumberSequence.new(1)
    local savedCameraVisuals = setmetatable({}, {__mode = "k"})
    local desiredCameraVisuals = setmetatable({}, {__mode = "k"})
    local cameraVisualConnections = setmetatable({}, {__mode = "k"})
    local cameraVisualWriting = setmetatable({}, {__mode = "k"})
    local watchedEggCamera = nil
    local eggCameraAddedConnection = nil

    local function disconnectVisualGuards(obj)
        local connections = cameraVisualConnections[obj]
        if connections then
            for _, conn in pairs(connections) do
                pcall(function() conn:Disconnect() end)
            end
            cameraVisualConnections[obj] = nil
        end
        desiredCameraVisuals[obj] = nil
        cameraVisualWriting[obj] = nil
    end

    local function changeCameraVisual(obj, property, value)
        if not obj or not obj.Parent then return end
        local record = savedCameraVisuals[obj]
        if not record then
            record = {}
            savedCameraVisuals[obj] = record
        end
        if record[property] == nil then
            local ok, original = pcall(function() return obj[property] end)
            if not ok then return end
            record[property] = {original}
        end
        local desired = desiredCameraVisuals[obj]
        if not desired then
            desired = {}
            desiredCameraVisuals[obj] = desired
        end
        desired[property] = value
        -- Keep visual properties from being reset by the normal hatch tweens.
        -- Connect ONLY while Hide Egg is ON and disconnect on OFF/secret.
        local links = cameraVisualConnections[obj]
        if not links then
            links = {}
            cameraVisualConnections[obj] = links
        end
        if not links[property] then
            local ok, signal = pcall(function()
                return obj:GetPropertyChangedSignal(property)
            end)
            if ok and signal then
                links[property] = signal:Connect(function()
                    if cameraVisualWriting[obj] or not alive or not hideEggEnabled
                        or secretActive(pickHatchGui()) then return end
                    local props = desiredCameraVisuals[obj]
                    local target = props and props[property]
                    if target == nil or not obj.Parent then return end
                    cameraVisualWriting[obj] = true
                    pcall(function() obj[property] = target end)
                    cameraVisualWriting[obj] = nil
                end)
            end
        end
        local ok, current = pcall(function() return obj[property] end)
        if ok and current ~= value then
            cameraVisualWriting[obj] = true
            pcall(function() obj[property] = value end)
            cameraVisualWriting[obj] = nil
        end
    end

    local function restoreCameraEggs()
        for obj, record in pairs(savedCameraVisuals) do
            disconnectVisualGuards(obj)
            if obj and obj.Parent then
                for property, boxed in pairs(record) do
                    pcall(function() obj[property] = boxed[1] end)
                end
            end
            savedCameraVisuals[obj] = nil
        end
    end

    local function hideCameraVisual(obj)
        if not obj or not obj.Parent then return end
        if obj:IsA("BasePart") then
            -- Normal egg shells, camera shockwaves and showcased hatch pets.
            -- Set both to defend against scripts which tween Transparency.
            changeCameraVisual(obj, "LocalTransparencyModifier", 1)
            changeCameraVisual(obj, "Transparency", 1)
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            changeCameraVisual(obj, "Transparency", 1)
        elseif obj:IsA("ParticleEmitter") then
            -- :Emit() ignores Enabled, but cannot draw opaque particles when
            -- its sequence is fully transparent. Clear already-drawn particles
            -- only the first time; avoid an expensive Clear() every scan.
            local firstHide = savedCameraVisuals[obj] == nil
            changeCameraVisual(obj, "Transparency", HIDDEN_SEQUENCE)
            changeCameraVisual(obj, "Enabled", false)
            if firstHide then pcall(function() obj:Clear() end) end
        elseif obj:IsA("Beam") or obj:IsA("Trail") then
            local firstHide = savedCameraVisuals[obj] == nil
            changeCameraVisual(obj, "Transparency", HIDDEN_SEQUENCE)
            changeCameraVisual(obj, "Enabled", false)
            if firstHide and obj:IsA("Trail") then
                pcall(function() obj:Clear() end)
            end
        elseif obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")
            or obj:IsA("Light") or obj:IsA("Highlight") then
            changeCameraVisual(obj, "Enabled", false)
        elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            changeCameraVisual(obj, "Enabled", false)
        elseif obj:IsA("GuiObject") then
            changeCameraVisual(obj, "Visible", false)
        elseif obj:IsA("PostEffect") then
            changeCameraVisual(obj, "Enabled", false)
        end
    end

    local function isNormalHatchRoot(obj)
        if not obj or type(obj.Name) ~= "string" then return false end
        local name = obj.Name
        return name:sub(1, 8) == "TS2Hatch"
            or name:match("^TS2PetGain_%d+$") ~= nil
    end

    local function applyCameraVisualTree(root)
        hideCameraVisual(root)
        for _, desc in ipairs(root:GetDescendants()) do
            hideCameraVisual(desc)
        end
    end

    local function normalHatchOwner(obj, camera)
        local current = obj
        while current and current.Parent ~= camera do
            current = current.Parent
        end
        if current and current.Parent == camera and isNormalHatchRoot(current) then
            return current
        end
        return nil
    end

    local function stopCameraWatcher()
        if eggCameraAddedConnection then
            pcall(function() eggCameraAddedConnection:Disconnect() end)
            eggCameraAddedConnection = nil
        end
        watchedEggCamera = nil
        restoreCameraEggs()
    end

    local function watchEggCamera(camera)
        if watchedEggCamera == camera then return end
        stopCameraWatcher()
        watchedEggCamera = camera
        if not camera then return end
        -- Catch each camera animation effect as soon as it is created.
        eggCameraAddedConnection = camera.DescendantAdded:Connect(function(obj)
            if not alive or not hideEggEnabled or secretActive(pickHatchGui()) then
                return
            end
            local owner = normalHatchOwner(obj, camera)
            if not owner then return end
            if obj == owner then
                applyCameraVisualTree(owner)
            else
                hideCameraVisual(obj)
            end
        end)
    end

    local function refreshCameraEggs(secret)
        if not alive or not hideEggEnabled then
            stopCameraWatcher()
            return
        end
        if secret then
            -- Let the original SecretHatchRenderer/Auto Hold own its visuals.
            restoreCameraEggs()
            return
        end
        local camera = workspace.CurrentCamera
        if watchedEggCamera ~= camera then
            watchEggCamera(camera)
        end
        if not camera then return end
        -- Only ~10-20 camera children, scanned on an existing 0.12s loop.
        -- No global Workspace scans or per-frame connections.
        for _, child in ipairs(camera:GetChildren()) do
            if isNormalHatchRoot(child) then
                if child:IsA("PostEffect") then
                    changeCameraVisual(child, "Enabled", false)
                else
                    applyCameraVisualTree(child)
                end
            end
        end
    end

    local function refresh()
        local hatch = pickHatchGui()
        if not alive or not hideEggEnabled then
            if watchedHatch then clearWatch() end
            if watchedOpening then clearOpening() end
            stopCameraWatcher()
            return
        end
        if hatch then
            if watchedHatch ~= hatch then bindGui(hatch) end
            if secretActive(hatch) then
                restoreAll()
            else
                applyHide(hatch)
            end
        elseif watchedHatch then
            clearWatch()
        end
        -- Hide the actual 3D eggs under CurrentCamera, not only GUI frames.
        local isSecret = secretActive(hatch)
        refreshOpening(isSecret)
        refreshCameraEggs(isSecret)
    end

    setHideEgg = toggle(hideEggRow, function(value)
        hideEggEnabled = value
        refresh()
        if not value then
            clearWatch()
        end
    end)

    on(pg.ChildAdded, function(child)
        if (child.Name == "HatchScreen" or child.Name == "Egg Opening Stuff")
            and hideEggEnabled then
            task.defer(refresh)
        end
    end)

    task.spawn(function()
        while alive do
            refresh()
            task.wait(hideEggEnabled and 0.12 or 0.75)
        end
        clearWatch()
    end)

    settingsUI.restoreEggView = function()
        clearWatch()
        clearOpening()
        stopCameraWatcher()
    end
end

-- =============================================================
-- EGG SECRET REVEAL: LOW-OVERHEAD / INPUT FALLBACKS
-- The reward is already decided by the server; we only interact with the
-- normal client reveal. Never destroy the renderer or modify game GUI.Enabled.
-- =============================================================
do
    local reveal = settingsUI.reveal
    local autoHold, autoSkip = false, false
    local holding = false
    local holdMethod, holdPoint, startedAt
    local nextHoldAt = 0
    local inputIndex = 1
    local lastSkipAt = 0
    local rendered = nil
    local cutscenes = nil
    -- Only cosmetic cutscene playback is intercepted; never the reward remote.
    local cinematicOwner = nil
    local cinematicOriginalPlay = nil
    local cinematicReplacement = nil
    local removeQueued = false
    local watchedHatchScreens = setmetatable({}, {__mode = "k"})
    local lastModuleLookup = -math.huge
    local touchId = 938512
    local lastPromptScan = -math.huge
    local cachedPrompt = nil
    local lastSkipTarget = nil
    local skipRequestSent = false
    local inputMethods = UIS.TouchEnabled
        and {"virtualuser", "touch", "virtualinput", "mouse", "newvirtual"}
        or {"mouse", "newvirtual", "virtualinput", "virtualuser", "touch"}

    local function status(value)
        if alive and reveal.status and reveal.status.Text ~= value then
            reveal.status.Text = value
        end
    end

    local function getRenderer()
        if rendered and cutscenes then return end
        if os.clock() - lastModuleLookup < 3 then return end
        lastModuleLookup = os.clock()
        local mods = RS:FindFirstChild("Modules")
        local client = mods and mods:FindFirstChild("Client")
        local pets = client and client:FindFirstChild("Pets")
        if not pets then return end
        for _, item in ipairs({
            {"SecretHatchRenderer", "renderer"},
            {"SecretHatchCutscenes", "cutscenes"}
        }) do
            local module = pets:FindFirstChild(item[1])
            if module and module:IsA("ModuleScript") then
                local ok, api = pcall(require, module)
                if ok and type(api) == "table" then
                    if item[2] == "renderer" then rendered = api
                    else cutscenes = api end
                end
            end
        end
    end

    local function playing(api)
        if not api or type(api.IsPlaying) ~= "function" then return false end
        local ok, v = pcall(function() return api:IsPlaying() end)
        return ok and v == true
    end

    local function visible(obj)
        if not obj:IsDescendantOf(pg) then return false end
        local p = obj
        while p and p ~= pg do
            if p:IsA("ScreenGui") and not p.Enabled then return false end
            if p:IsA("GuiObject") and not p.Visible then return false end
            p = p.Parent
        end
        return true
    end

    -- Scan only while the game says a reveal is playing, or as a slow
    -- fallback if the renderer does not expose IsPlaying on this build.
    local function findHoldPrompt()
        for _, obj in ipairs(pg:GetDescendants()) do
            if (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
                local text = obj.Text:lower()
                if (text:find("hold to reveal", 1, true)
                    or text:find("hold to open", 1, true)
                    or (text:find("hold", 1, true) and text:find("reveal", 1, true)))
                    and visible(obj) then
                    return obj
                end
            end
        end
        return nil
    end

    local function holdPointFor(prompt)
        local camera = workspace.CurrentCamera
        if not camera then return nil end
        local view = camera.ViewportSize
        local p = Vector2.new(view.X * 0.5, view.Y * 0.58)
        if prompt and prompt.AbsoluteSize.X > 0 then
            local center = prompt.AbsolutePosition + prompt.AbsoluteSize * 0.5
            if center.X > 4 and center.Y > 4
                and center.X < view.X - 4 and center.Y < view.Y - 4 then
                p = center
            end
        end
        if window.Visible then
            local pos, size = window.AbsolutePosition, window.AbsoluteSize
            if p.X >= pos.X and p.X <= pos.X + size.X
                and p.Y >= pos.Y and p.Y <= pos.Y + size.Y then
                p = Vector2.new(view.X * 0.92, view.Y * 0.78)
            end
        end
        return p
    end

    -- The game sets these attributes on the actual HatchScreen ScreenGui.
    -- Check only direct PlayerGui children instead of walking every descendant.
    local function activeRevealScreen()
        for _, gui in ipairs(pg:GetChildren()) do
            if gui:IsA("ScreenGui") and gui:GetAttribute("TS2SecretHatchActive") == true then
                return gui
            end
        end
        return nil
    end

    -- Official controller's gamepad binding calls renderer:BeginHold() and
    -- renderer:EndHold(). Prefer that existing public module API over
    -- fake touch and mouse events (often blocked by Delta/mobile).
    local function directHoldDown()
        getRenderer()
        if type(rendered) ~= "table"
            or type(rendered.BeginHold) ~= "function"
            or type(rendered.GetDebugState) ~= "function"
            or not playing(rendered) then
            return false
        end
        local ok, state = pcall(function() return rendered:GetDebugState() end)
        if not ok or type(state) ~= "table"
            or state.Stage ~= "AwaitingHold" then
            return false
        end
        local began = pcall(function() rendered:BeginHold() end)
        if not began then return false end
        local confirmed, updated = pcall(function() return rendered:GetDebugState() end)
        return confirmed and type(updated) == "table"
            and (updated.Holding == true or updated.Stage == "Holding")
    end

    local function inputDown(method, point)
        if method == "virtualuser" then
            local vu = game:GetService("VirtualUser")
            local cam = workspace.CurrentCamera
            if not cam then return false end
            return pcall(function() vu:Button1Down(point, cam.CFrame) end)
        elseif method == "mouse" then
            if type(mouse1press) ~= "function"
                or type(mouse1release) ~= "function" then return false end
            if type(mousemoveabs) == "function" then
                pcall(mousemoveabs, point.X, point.Y)
            end
            return pcall(mouse1press)
        elseif method == "virtualinput" then
            return pcall(function()
                game:GetService("VirtualInputManager"):SendMouseButtonEvent(
                    math.floor(point.X), math.floor(point.Y), 0, true, game, 0)
            end)
        elseif method == "touch" then
            return pcall(function()
                -- SendTouchEvent expects integer state, not an EnumItem.
                game:GetService("VirtualInputManager"):SendTouchEvent(
                    touchId, Enum.UserInputState.Begin.Value, point.X, point.Y)
            end)
        elseif method == "newvirtual" then
            return pcall(function()
                game:GetService("VirtualInput"):SendMouseButton(
                    point, Enum.UserInputType.MouseButton1, true, 0)
            end)
        end
        return false
    end

    local function inputUp(method, point)
        if not method then return end
        if method == "renderer-api" then
            if rendered and type(rendered.EndHold) == "function" then
                pcall(function() rendered:EndHold() end)
            end
            return
        end
        if not point then return end
        if method == "virtualuser" then
            pcall(function()
                local cam = workspace.CurrentCamera
                game:GetService("VirtualUser"):Button1Up(
                    point, cam and cam.CFrame or CFrame.new())
            end)
        elseif method == "mouse" and type(mouse1release) == "function" then
            pcall(mouse1release)
        elseif method == "virtualinput" then
            pcall(function()
                game:GetService("VirtualInputManager"):SendMouseButtonEvent(
                    math.floor(point.X), math.floor(point.Y), 0, false, game, 0)
            end)
        elseif method == "touch" then
            pcall(function()
                game:GetService("VirtualInputManager"):SendTouchEvent(
                    touchId, Enum.UserInputState.End.Value, point.X, point.Y)
            end)
        elseif method == "newvirtual" then
            pcall(function()
                game:GetService("VirtualInput"):SendMouseButton(
                    point, Enum.UserInputType.MouseButton1, false, 0)
            end)
        end
    end

    local function releaseHold(succeeded)
        if not holding then return end
        local method, point = holdMethod, holdPoint
        holding = false
        holdMethod, holdPoint = nil, nil
        inputUp(method, point)
        if succeeded then
            -- Only retry when the next reveal is in AwaitingHold.
            -- No arbitrary two-second gap between consecutive secrets.
            nextHoldAt = os.clock() + 0.12
            inputIndex = 1
            status("REVEAL SCREEN CLOSED")
        else
            inputIndex = inputIndex % #inputMethods + 1
            nextHoldAt = os.clock() + 0.75
            status("RETRYING INPUT")
        end
    end

    local function beginHold(prompt)
        if holding or os.clock() < nextHoldAt then return end
        local point = holdPointFor(prompt)
        if not point then return end
        if directHoldDown() then
            holding = true
            holdMethod, holdPoint = "renderer-api", point
            startedAt = os.clock()
            status("HOLDING (GAME API)")
            return
        end
        -- When the API is available but the renderer has not yet entered
        -- AwaitingHold, do NOT synthesize a tap on unrelated gameplay/UI.
        if not prompt then return end
        for n = 0, #inputMethods - 1 do
            local index = (inputIndex - 1 + n) % #inputMethods + 1
            local method = inputMethods[index]
            if inputDown(method, point) then
                holding = true
                holdMethod, holdPoint = method, point
                inputIndex = index
                startedAt = os.clock()
                status("HOLDING (" .. method .. ")")
                return
            end
        end
        nextHoldAt = os.clock() + 4
        status("INPUT BLOCKED BY EXECUTOR")
    end

    -- V11.9.4: REMOVE rather than merely skipping a cutscene once visible.
    -- IMPORTANT: The existing BeginHold/EndHold implementation above is
    -- intentionally untouched. We only react after the hold has completed.
    -- SecretHatchRenderer:Cancel() invokes the game's own finish(), cleanup,
    -- OnFinished and ReleaseScreen. The special bridge's :Play() is intercepted
    -- *before* it starts, and its completion callback is retained.
    local function rendererStage()
        if not playing(rendered) or type(rendered.GetDebugState) ~= "function" then
            return nil
        end
        local ok, data = pcall(function() return rendered:GetDebugState() end)
        return ok and type(data) == "table" and data.Stage or nil
    end

    local function afterHold(stage)
        return stage == "Animating" or stage == "Finisher"
            or stage == "PetCardReveal" or stage == "WorldReveal"
    end

    local function restoreCinematic()
        if cinematicOwner and cinematicOriginalPlay and cinematicReplacement then
            pcall(function()
                if cinematicOwner.Play == cinematicReplacement then
                    cinematicOwner.Play = cinematicOriginalPlay
                end
            end)
        end
        cinematicOwner, cinematicOriginalPlay, cinematicReplacement = nil, nil, nil
    end

    local function preventCinematicStart()
        if not autoSkip or not cutscenes then return end
        if cinematicOwner == cutscenes and cutscenes.Play == cinematicReplacement then
            return
        end
        if type(cutscenes.Play) ~= "function" then return end
        restoreCinematic()
        local original = cutscenes.Play
        local replacement = function(self, pet, onFinished, options)
            if not alive or not autoSkip or type(onFinished) ~= "function" then
                return original(self, pet, onFinished, options)
            end
            -- The pet reward was already determined server-side. Keep the
            -- client completion callback, but do not create cinematic visuals,
            -- cutscene cameras, ScreenHide bridge, or long waits.
            task.defer(function()
                local ok, err = pcall(onFinished, "Completed")
                if not ok then warn("[AGONY REMOVE CUTSCENES] Callback:", err) end
            end)
            status("CUTSCENE REMOVED")
            return true, "Cosmetic cinematic bypassed"
        end
        local ok = pcall(function() cutscenes.Play = replacement end)
        if ok and cutscenes.Play == replacement then
            cinematicOwner = cutscenes
            cinematicOriginalPlay = original
            cinematicReplacement = replacement
        else
            status("CINEMATIC BYPASS UNAVAILABLE")
        end
    end

    local function removePostHoldReveal()
        -- task.defer is crucial: the game's stage attribute is set from
        -- inside startAnimation(), before the track and camera finish setting
        -- up. Never cancel synchronously in that callback.
        if removeQueued or not autoSkip or not alive then return end
        removeQueued = true
        task.defer(function()
            removeQueued = false
            if not alive or not autoSkip or not rendered
                or type(rendered.Cancel) ~= "function"
                or not playing(rendered) then
                return
            end
            local stage = rendererStage()
            if not afterHold(stage) then return end
            local ok, err = pcall(function() rendered:Cancel() end)
            if ok then
                status("CUTSCENE REMOVED")
            else
                warn("[AGONY REMOVE CUTSCENES] Reveal cleanup:", err)
                status("REMOVE FAILED")
            end
        end)
    end

    -- Event-driven, no continual scanning or Enabled changes. The game's
    -- HatchScreen emits this attribute when its 0.6s hold has finished.
    local function watchHatchScreen(gui)
        if not gui or not gui:IsA("ScreenGui")
            or gui.Name ~= "HatchScreen" or watchedHatchScreens[gui] then
            return
        end
        watchedHatchScreens[gui] = true
        on(gui:GetAttributeChangedSignal("TS2SecretHatchStage"), function()
            if autoSkip and afterHold(gui:GetAttribute("TS2SecretHatchStage")) then
                removePostHoldReveal()
            end
        end)
        if autoSkip and afterHold(gui:GetAttribute("TS2SecretHatchStage")) then
            removePostHoldReveal()
        end
    end
    for _, gui in ipairs(pg:GetChildren()) do watchHatchScreen(gui) end
    on(pg.ChildAdded, watchHatchScreen)

    reveal.setHold = toggle(reveal.holdRow, function(v)
        autoHold = v
        if not v then
            releaseHold(false)
            cachedPrompt = nil
            status(autoSkip and "SKIP WATCHING" or "IDLE")
        else
            status("AUTO HOLD READY")
        end
    end)
    reveal.setSkip = toggle(reveal.skipRow, function(v)
        autoSkip = v
        if v then
            getRenderer()
            preventCinematicStart()
            for _, gui in ipairs(pg:GetChildren()) do watchHatchScreen(gui) end
            removePostHoldReveal()
            status("REMOVE CUTSCENES ON")
        else
            restoreCinematic()
            status(autoHold and "AUTO HOLD READY" or "IDLE")
        end
    end)
    reveal.shutdown = restoreCinematic
    reveal.isHold = function() return autoHold end
    reveal.isSkip = function() return autoSkip end

    -- Continuously watch every new secret reveal, even when the hub GUI is
    -- closed, hatch mode changes, or several secrets arrive back to back.
    -- A single runtime error must not kill the worker permanently.
    local lastWorkerWarning = -math.huge
    local function revealTick()
        if not (autoHold or autoSkip or holding) then return 0.8 end
        getRenderer()
        if autoSkip then preventCinematicStart() end

        local gameScreen = activeRevealScreen()
        local rendererLive = playing(rendered)
        local sceneLive = playing(cutscenes)
        local live = rendererLive or sceneLive or gameScreen ~= nil
        local stage = rendererLive and rendererStage() or nil
        if type(stage) ~= "string" and gameScreen then
            stage = gameScreen:GetAttribute("TS2SecretHatchStage")
        end
        local awaiting = stage == "AwaitingHold"
        local postHold = afterHold(stage)
        local now = os.clock()

        if holding then
            if not autoHold then
                releaseHold(false)
            elseif postHold or not live then
                -- On completion, EndHold is already a no-op in the native
                -- renderer. Finish our local hold state and watch the next pet.
                releaseHold(true)
            elseif now - (startedAt or now) > 2.2 then
                -- Native hold normally completes in 0.6s. A timed-out hold
                -- is a failed attempt; safely release and retry next cycle.
                releaseHold(false)
            end
        end

        if autoSkip and rendererLive and postHold then
            removePostHoldReveal()
        elseif autoSkip and sceneLive and not rendererLive then
            status("CUTSCENE ACTIVE")
        end

        if autoHold and live and awaiting and not holding and now >= nextHoldAt then
            -- Preferred path: renderer API, independent of visible GUI text.
            -- Never require a prompt for the native BeginHold path.
            if rendererLive and rendered
                and type(rendered.BeginHold) == "function" then
                beginHold(nil)
            else
                -- Fallback for game versions with no exposed renderer API.
                -- Only scan PlayerGui during an active AwaitingHold stage.
                if now - lastPromptScan >= 0.25 then
                    lastPromptScan = now
                    cachedPrompt = findHoldPrompt()
                end
                if cachedPrompt and cachedPrompt.Parent and visible(cachedPrompt) then
                    beginHold(cachedPrompt)
                end
            end
        end
        if not live then
            cachedPrompt = nil
            lastPromptScan = -math.huge
            lastSkipTarget = nil
            skipRequestSent = false
        end
        return live and 0.12 or 0.75
    end

    -- Both reveal helpers start enabled. Config loading may still apply the
    -- player's explicitly saved ON/OFF choices through the existing setters.
    reveal.setHold(true)
    reveal.setSkip(true)
    task.spawn(function()
        while alive do
            local ok, interval = pcall(revealTick)
            if not ok then
                if os.clock() - lastWorkerWarning > 15 then
                    lastWorkerWarning = os.clock()
                    warn("[AGONY REVEAL] Worker recovered:", tostring(interval))
                end
                interval = 0.45
            end
            task.wait(type(interval) == "number" and interval or 0.45)
        end
        releaseHold(false)
    end)
end

