    local function buyTick()
        if (not enabled or parked or completed) and not pending then return end
        local now = os.clock()
        local data = readData()
        if not alive then return end
        -- Acknowledgement is read from replicated unlock state, never inferred
        -- from FireServer success. Pending survives an OFF/ON cycle.
        if pending then
            if bossFighting or (flags.boss and bossPresent) or hatchTradePaused() then releaseApproach() end
            if pending.Kind == "TimeRiftUnlock" then
                local worlds = data and data.Progression.UnlockedWorlds
                if type(worlds) == "table" and worlds.TimeRift == true then
                    pending = nil
                    entranceCount = 0
                    timeRiftApproached = false
                    riftEntranceRoot, riftEntranceAt = nil, -math.huge
                    riftTransferRoot, riftTransferAt = nil, -math.huge
                    -- Prefer native travel. If it fails to start, the existing
                    -- already-unlocked branch may attempt one World 2 transfer.
                    riftTravelDeadline = now + 12
                    clearRiftEntry()
                    riftResult = nil
                    -- Retain our movement lease during native travel so hatch
                    -- and chest tasks cannot pull the character away.
                    if not enabled then releaseApproach() end
                    nextAttempt = now + 7
                    consolePrint("[AGONY AUTO BUY ISLAND] Time Rift unlocked; waiting for native world travel")
                    say(enabled and "Time Rift unlocked" or "OFF / Rift unlocked", C.green)
                elseif riftResult and riftResult.Success == false and riftResult.AlreadyUnlocked ~= true then
                    local reason = tostring(riftResult.Reason or "Unknown rejection")
                    pending, riftResult = nil, nil
                    clearRiftEntry()
                    halt("Time Rift rejected: OFF", C.red)
                    consoleWarn("[AGONY AUTO BUY ISLAND] Time Rift purchase rejected:", reason)
                elseif now >= pending.Deadline then
                    pending = nil
                    nextAttempt = now + 3
                    halt("Time Rift unlock unconfirmed", C.red)
                    consoleWarn("[AGONY AUTO BUY ISLAND] Time Rift unlock not confirmed; check native portal.")
                else
                    say(enabled and "Awaiting Time Rift unlock" or "OFF / Rift pending")
                end
                return
            end
            if data and data.Progression.UnlockedIslands[pending.Name] == true then
                local bought = pending.Name
                pending = nil
                lastBoughtName, lastBoughtAt = bought, now
                if bought == "Medieval Island" then
                    wildWestExpected = data.Progression.UnlockedIslands["Wild West"] ~= true
                elseif bought == "Wild West" then
                    wildWestExpected, wildWestConfirm = false, nil
                end
                print("[AGONY AUTO BUY ISLAND] Confirmed purchase", bought)
                approach = nil
                riftConfirm = nil
                approachKey, approachCount = nil, 0
                if not enabled then releaseApproach() end
                nextAttempt = now + 7 -- cooldown after confirmed purchase
                nextLabel.Text = bought
                say(enabled and "Purchased" or "OFF / purchased", C.green)
                if enabled and bought == "Wild West" then
                    local riftCatalog = getCatalog("TimeRift")
                    local allOwned = riftCatalog ~= nil
                    for _, entry in ipairs(riftCatalog or {}) do
                        if data.Progression.UnlockedIslands[entry.Name] ~= true then allOwned = false; break end
                    end
                    if allOwned and alive and enabled then
                        completed = true
                        releaseApproach()
                        restoreConfirm()
                        say("World complete / ON (idle)", C.green)
                        consolePrint("[AGONY AUTO BUY ISLAND] Final island confirmed; hatch priority released")
                    end
                end
            elseif now >= pending.Deadline then
                local failed = pending.Name
                pending = nil
                nextAttempt = now + 3
                halt("Unconfirmed: OFF", C.red)
                warn("[AGONY AUTO BUY ISLAND] Purchase not confirmed:", tostring(failed))
            else
                say(enabled and "Awaiting server" or "OFF / pending")
            end
            return
        end
        if not enabled or parked or completed then return end
        if not data then
            if approach and now - approach.ready >= 8 then
                warn("[AGONY AUTO BUY ISLAND] Player data unavailable:", approach.name)
                halt("Player data unavailable: OFF", C.red)
            end
            say("Waiting for data"); return
        end
        local world, balance = worldAndBalance(data)
        if not alive or not enabled then return end
        if not world then
            if approach and now - approach.ready >= 8 then
                warn("[AGONY AUTO BUY ISLAND] World data unavailable:", approach.name)
                halt("World data unavailable: OFF", C.red)
            end
            say("World not ready"); return
        end
        if riftTravelDeadline then
            if world == "TimeRift" and player:GetAttribute("World") == "TimeRift" then
                riftTravelDeadline = nil
                releaseApproach()
                consolePrint("[AGONY AUTO BUY ISLAND] Native World 2 confirmed")
            elseif now >= riftTravelDeadline then
                riftTravelDeadline = nil
                local worlds = data.Progression.UnlockedWorlds
                if world == "Main" and type(worlds) == "table" and worlds.TimeRift == true
                    and player:GetAttribute("World") ~= "TimeRift" then
                    -- Fall through to the existing single-transfer branch only
                    -- after ownership is confirmed. It still waits for server world state.
                    consoleWarn("[AGONY AUTO BUY ISLAND] Native travel not confirmed; using unlocked World 2 transfer")
                    releaseApproach()
                else
                    halt("World travel unconfirmed: OFF", C.red)
                    consoleWarn("[AGONY AUTO BUY ISLAND] World replica and player world do not agree; check native travel")
                    return
                end
            else
                say("Waiting for native World 2 travel")
                return
            end
        end
        if world == "TimeRift" then
            if timeRiftApproached then releaseApproach() end
            timeRiftApproached = false
            riftEntranceRoot, riftEntranceAt = nil, -math.huge
            riftTransferRoot, riftTransferAt = nil, -math.huge
        end
        local catalog = getCatalog(world)
        if not alive or not enabled then return end
        if not catalog then releaseApproach(); say("Config not ready"); return end
        local target
        for _, entry in ipairs(catalog) do
            if data.Progression.UnlockedIslands[entry.Name] ~= true then
                target = entry
                break
            end
        end
        if not target then
            if world == "Main" then
                nextLabel.Text = "Prehistoric Island"
                -- Time Rift is a distinct world purchase; the observed
                -- UnlockRequested event has no arguments. Direct transfer is
                -- permitted only after replica-confirmed world ownership.
                local unlocked = data.Progression.UnlockedWorlds
                local isUnlocked = type(unlocked) == "table" and unlocked.TimeRift == true
                local worldConfig = readModule("World", {"Shared", "Progression", "WorldConfig"})
                local rift = worldConfig and worldConfig.Worlds and worldConfig.Worlds.TimeRift
                local requirement = rift and rift.Unlock
                if not alive or not enabled then return end
                if not isUnlocked then
                    if now < nextAttempt then return end
                    if type(unlocked) ~= "table" or type(requirement) ~= "table"
                        or type(requirement.Island) ~= "string" or type(requirement.Price) ~= "number"
                        or requirement.Price ~= requirement.Price or requirement.Price <= 0 or requirement.Price == math.huge then
                        releaseApproach(); say("Rift requirements not ready"); return
                    end
                    if data.Progression.UnlockedIslands[requirement.Island] ~= true then
                        releaseApproach(); say("Unlock Heaven first"); return
                    end
                    if balance < requirement.Price then
                        releaseApproach(); say("Need more World 1 coins"); return
                    end
                end
                if bossFighting or (flags.boss and bossPresent) or hatchTradePaused()
                    or (busyMovement and not ownsMovement) then
                    timeRiftApproached = false
                    releaseApproach(); return
                end
                local rr, hh = currentRoot(), currentHum()
                if not rr or not hh or hh.Health <= 0 then releaseApproach(); return end
                local measured = CFrame.new(-52.5616074, -370.472809, -1528.7002, 0.999927938, 0, 0.0119985426, 0, 1, 0, -0.0119985426, 0, 0.999927938)
                -- Do not pull a character who has already entered Rift back
                -- to World 1 while the server replica is catching up.
                local physicallyInRift = inRiftArea(rr)
                if not alive or not enabled or currentRoot() ~= rr then return end
                if isUnlocked then
                    -- Do not revisit the entrance after a confirmed unlock.
                    -- Use the existing manual World 2 spawn, with upright
                    -- clearance; never modify replicated world or currency data.
                    if riftTransferRoot == rr then
                        if now-riftTransferAt >= 15 then
                            halt("Time Rift world update unconfirmed", C.red)
                            warn("[AGONY AUTO BUY ISLAND] Time Rift unlocked; server world update not confirmed after transfer.")
                        else
                            say("Waiting for server world update")
                        end
                        return
                    end
                    if physicallyInRift or player:GetAttribute("World") == "TimeRift" then
                        riftTransferRoot, riftTransferAt = rr, now
                        say("Waiting for server world update")
                        return
                    end
                    local destination = Vector3.new(114.067284,492.25766,7009.61865)
                    local landing = CFrame.new(destination + Vector3.new(0,12,0))
                    -- Keep a single transfer per character while awaiting
                    -- replication; request streaming without blocking the worker.
                    ownsMovement=true; busyMovement=true
                    timeRiftApproached=true
                    riftTransferRoot, riftTransferAt = rr, now
                    riftEntranceRoot, riftEntranceAt = nil, -math.huge
                    task.spawn(function()
                        pcall(function() player:RequestStreamAroundAsync(destination,3) end)
                    end)
                    rr.AssemblyLinearVelocity=Vector3.zero
                    rr.AssemblyAngularVelocity=Vector3.zero
                    rr.CFrame=landing
                    say("Transferred to World 2", C.green)
                    return
                end
                if physicallyInRift then
                    releaseApproach()
                    say("Time Rift not unlocked")
                    return
                end
                -- Require the actual server encounter before sending the
                -- purchase; a local coordinate or elapsed delay is not proof.
                if not bindRiftSignals() then
                    say("Waiting for Time Rift signals")
                    return
                end
                if riftEntryAt and riftEntryRoot == rr and now-riftEntryAt <= 12 then
                    local unlockEvent = getRemote({"RemoteServices", "TimeRiftService", "RE", "UnlockRequested"}, "RemoteEvent")
                    if not unlockEvent then say("Rift unlock remote unavailable"); return end
                    local latest = readData()
                    if not alive or not enabled or not latest or currentRoot() ~= rr
                        or currentHum() ~= hh or hh.Health <= 0
                        or bossFighting or (flags.boss and bossPresent) or hatchTradePaused() then return end
                    local latestWorld, latestBalance = worldAndBalance(latest)
                    local latestWorlds = latest.Progression.UnlockedWorlds
                    if not alive or not enabled or latestWorld ~= "Main" or not latestBalance
                        or latestBalance < requirement.Price or type(latestWorlds) ~= "table"
                        or latestWorlds.TimeRift == true
                        or latest.Progression.UnlockedIslands[requirement.Island] ~= true
                        or currentRoot() ~= rr or currentHum() ~= hh or hh.Health <= 0
                        or not riftEntryAt or riftEntryRoot ~= rr or os.clock()-riftEntryAt > 12
                        or bossFighting or (flags.boss and bossPresent) or hatchTradePaused() then return end
                    clearRiftEntry()
                    riftResult = nil
                    pending = {Kind = "TimeRiftUnlock", Deadline = os.clock() + 20}
                    say("Unlocking Time Rift...")
                    consolePrint("[AGONY AUTO BUY ISLAND] Sending Time Rift purchase after server encounter")
                    local ok, err = pcall(function() unlockEvent:FireServer() end)
                    if not ok then
                        pending = nil
                        halt("Time Rift request failed", C.red)
                        consoleWarn("[AGONY AUTO BUY ISLAND] Time Rift request failed:", tostring(err))
                    end
                    return
                end
                if entranceCount > 0 then
                    if now-riftEntranceAt >= 25 then
                        halt("No Time Rift encounter: OFF", C.red)
                        consoleWarn("[AGONY AUTO BUY ISLAND] No fresh Time Rift purchase encounter. Approach the portal normally and check the purchase dialog.")
                    else
                        say("Waiting for portal encounter")
                    end
                    return
                end
                -- One approach only; let the server validate the encounter.
                entranceCount = entranceCount + 1
                clearRiftEntry()
                ownsMovement=true; busyMovement=true
                timeRiftApproached=true
                riftEntranceRoot, riftEntranceAt = rr, now
                rr.AssemblyLinearVelocity=Vector3.zero
                rr.AssemblyAngularVelocity=Vector3.zero
                rr.CFrame=measured
                say("Waiting for Time Rift encounter", C.green)
                consolePrint("[AGONY AUTO BUY ISLAND] Time Rift approach; waiting for server encounter")
                return
            end
            nextLabel.Text="--"
            wildWestExpected, wildWestConfirm = false, nil
            completed = true
            releaseApproach()
            restoreConfirm()
            say("World complete / ON (idle)", C.green)
            return
        end
        nextLabel.Text = target.Name
        wildWestExpected = world == "TimeRift" and target.Name == "Wild West"
        if not wildWestExpected then wildWestConfirm = nil end
        if balance < target.Price then
            wildWestConfirm = nil
            releaseApproach(); say("Need more coins"); return
        end
        if wildWestExpected then
            -- Arm the native dialog handler before the cooldown/approach,
            -- not after reaching the last portal.
            local installed = installConfirm()
            if not alive or not enabled then return end
            if not installed then
                say("Wild West confirmation handler unavailable", C.red)
                -- Continue to the normal portal; the game may show its own
                -- dialog. Its manual success is still replica-confirmed.
            end
        end
        if bossFighting or (flags.boss and bossPresent) or hatchTradePaused() then
            releaseApproach(); say("Busy: waiting"); return
        end
        if now < nextAttempt then say("Next in " .. tostring(math.ceil(nextAttempt-now)) .. "s"); return end
        if busyMovement and not ownsMovement then say("Busy: waiting"); return end
        local r,h=currentRoot(),currentHum()
        if not r or not h or h.Health<=0 then releaseApproach(); say("No character"); return end
        local key = world .. ":" .. target.Name
        if approachKey ~= key then
            approachKey, approachCount = key, 0
        end
        local overrideStand = portalStandFor(world, target.Name, approachCount)
        if approach and (approach.name ~= target.Name or approach.world ~= world or approach.root ~= r) then
            releaseApproach()
        end
        if wildWestExpected and validWildWestConfirm(r, now) then
            -- A real, target-specific native encounter already occurred.
            -- Preserve that position rather than teleporting away from it.
            if not approach or approachDrifted(approach) then
                ownsMovement = true; busyMovement = true
                approach = {name=target.Name, world=world, root=r,
                    stand=wildWestConfirm.Stand, ready=now}
            end
        elseif wildWestExpected then
            wildWestConfirm = nil
        end
        -- Give physics/streaming the complete settle interval before judging
        -- the landing, and allow only one retry per target.
        if approach and now >= approach.ready and approachDrifted(approach) then
            local delta = r.Position - approach.stand.Position
            releaseApproach()
            warn("[AGONY AUTO BUY ISLAND] Portal displacement before purchase:", target.Name, tostring(delta))
            streamAfter = now + 3
        end
        if not approach then
            if now < streamAfter then return end
            if approachCount >= 2 then
                halt("Portal approach failed: OFF", C.red)
                warn("[AGONY AUTO BUY ISLAND] Stopped after two approaches:", target.Name)
                return
            end
            local part, stand = nil, overrideStand
            if stand then
                local targetPosition = stand.Position
                task.spawn(function() pcall(function() player:RequestStreamAroundAsync(targetPosition, 3) end) end)
            end
            if not stand then
                part = portalFor(target, world)
                if not part then
                    streamAfter = now + 7
                    say("Portal not loaded")
                    local hint = type(target.Landing) == "table" and target.Landing.From
                    if world == "Main" then hint = mainStreamHints[target.Order] end
                    if typeof(hint) == "Vector3" then task.spawn(function() pcall(function() player:RequestStreamAroundAsync(hint,3) end) end) end
                    return
                end
                stand = standNear(part, r, h)
            end
            if not stand then streamAfter = now + 7; say("No safe portal spot", C.red); return end
            local popupOK = installConfirm()
            if not alive or not enabled or currentRoot() ~= r then return end
            if bossFighting or (flags.boss and bossPresent) or hatchTradePaused()
                or (busyMovement and not ownsMovement) then return end
            ownsMovement = true; busyMovement = true
            approachCount = approachCount + 1
            approach = {name = target.Name, world = world, root = r, part = part, stand = stand, ready = os.clock() + (world == "TimeRift" and 1.5 or 0.8)}
            if world == "TimeRift" then streamAfter = os.clock() + 3 end
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
            r.CFrame = stand
            say(popupOK and "At portal" or "At portal / popup possible")
            print("[AGONY AUTO BUY ISLAND] Approach", world, target.Name, approachCount)
            return
        end
        if now<approach.ready then say("Portal: "..math.ceil(approach.ready-now).."s"); return end
        local event
        if world == "Main" then
            event = getRemote({"RemoteServices", "IslandService", "RE", "IslandUnlockRequested"}, "RemoteEvent")
        end
        if world == "Main" and not event then
            if now - approach.ready >= 8 then
                halt("Island remote not ready: OFF", C.red)
                warn("[AGONY AUTO BUY ISLAND] Island purchase remote unavailable:", target.Name)
            else
                say("Remote not ready")
            end
            return
        end
        -- Re-read balance/world immediately before the purchase, since module
        -- loading may yield. Do not buy if the selected world/state changed.
        local latest = readData()
        if not alive or not enabled then releaseApproach(); return end
        if not latest then
            if now - approach.ready >= 8 then
                warn("[AGONY AUTO BUY ISLAND] Player data unavailable before purchase:", target.Name)
                halt("Player data unavailable: OFF", C.red)
            end
            return
        end
        local latestWorld, latestBalance = worldAndBalance(latest)
        if not alive or not enabled then releaseApproach(); return end
        if not latestWorld or not latestBalance then
            if now - approach.ready >= 8 then
                warn("[AGONY AUTO BUY ISLAND] World or currency data unavailable:", target.Name)
                halt("World data unavailable: OFF", C.red)
            end
            return
        end
        if latestWorld ~= world or latestBalance < target.Price then releaseApproach(); return end
        if latest.Progression.UnlockedIslands[target.Name] == true then releaseApproach(); return end
        for _, entry in ipairs(catalog) do
            if entry.Order >= target.Order then break end
            if latest.Progression.UnlockedIslands[entry.Name] ~= true then releaseApproach(); return end
        end
        if not approach or approach.root ~= currentRoot() then releaseApproach(); return end
        if bossFighting or (flags.boss and bossPresent) or hatchTradePaused() then releaseApproach(); return end
        -- No silent release/reteleport after the preflight. The next tick
        -- handles displacement with the same bounded approach counter.
        if approachDrifted(approach) then return end
        -- Use only the native Rift dialog callback if the game supplies one.
        -- The observed World 1 purchase payload was rejected in World 2.
        local callback
        if world == "TimeRift" then
            if player:GetAttribute("World") ~= "TimeRift" then
                if now - approach.ready >= 12 then
                    halt("World 2 state unconfirmed: OFF", C.red)
                    consoleWarn("[AGONY AUTO BUY ISLAND] World 2 player attribute not confirmed")
                end
                return
            end
            if wildWestExpected and validWildWestConfirm(currentRoot(), os.clock()) then
                callback = wildWestConfirm.Callback
                wildWestConfirm = nil
                riftConfirm = nil
            elseif riftConfirm and riftConfirm.Name == target.Name and riftConfirm.Root == currentRoot()
                and os.clock() - riftConfirm.At <= 12 then
                callback = riftConfirm.Callback
                riftConfirm = nil
            else
                riftConfirm = nil
                if now - approach.ready >= 15 then
                    halt("Native Rift confirmation missing: OFF", C.red)
                    consoleWarn("[AGONY AUTO BUY ISLAND] No native Rift purchase confirmation:", target.Name,
                        "Use the normal portal dialog manually; no speculative request sent.")
                else
                    say("Waiting for native Rift confirmation")
                end
                return
            end
        end
        pending = {Name = target.Name, Deadline = os.clock() + 12}
        say("Buying...")
        print("[AGONY AUTO BUY ISLAND] Sending purchase", world, target.Name)
        local ok = pcall(function()
            if world == "TimeRift" then
                callback()
            else
                event:FireServer({Action = "Purchase", Island = target.Name})
            end
        end)
        if not ok then
            pending = nil
            nextAttempt = os.clock() + 3
            halt("Request failed: OFF", C.red)
        end
    end
    task.spawn(function()
        while alive do
            if enabled and parked and wildWestExpected and not pending then
                -- Passive recovery only. If the player buys the final portal
                -- manually after a failure, recheck the catalog and resume hatch.
                local ok, owned = pcall(function()
                    local data = readData()
                    return data and data.Progression.UnlockedIslands["Wild West"] == true
                end)
                if ok and owned and enabled and parked and wildWestExpected then
                    parked = false
                    wildWestExpected, wildWestConfirm = false, nil
                    nextAttempt = os.clock() + 7
                    consolePrint("[AGONY AUTO BUY ISLAND] Wild West unlock confirmed after pause")
                end
            end
            if (enabled and not parked and not completed) or pending then
                local ok, err = pcall(buyTick)
                if not ok and alive then
                    warn("[AGONY AUTO BUY ISLAND]", tostring(err))
                    halt("Error: OFF", C.red)
                end
            end
            task.wait(0.5)
        end
    end)
end
