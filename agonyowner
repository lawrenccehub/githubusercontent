-- V11.9.53: Event-driven Anti AFK; no constant input loop or GUI scanning.
-- The Idled signal is connected through the hub's normal cleanup registry.
-- Using VirtualUser is best-effort: an executor/platform may restrict it.
do
    local enabled = false
    local virtualUser = nil
    local lastAttempt = -math.huge
    local function preventIdle()
        if not alive or not enabled then return end
        local now = os.clock()
        if now - lastAttempt < 10 then return end
        lastAttempt = now
        if not virtualUser then
            local ok, obj = pcall(function()
                return game:GetService("VirtualUser")
            end)
            if ok then virtualUser = obj end
        end
        if virtualUser then
            pcall(function()
                virtualUser:CaptureController()
                virtualUser:ClickButton2(Vector2.new(0, 0))
            end)
        end
    end
    on(player.Idled, preventIdle)
    settingsUI.antiAfkIsOn = function()
        return enabled
    end
    settingsUI.setAntiAfk = toggle(antiAfkRow, function(value)
        enabled = value
    end)
    -- Default ON; existing saved configs without this field keep ON.
    settingsUI.setAntiAfk(true)
end

-- Shared HTTP helper for user-configured Discord webhook only.
-- No usage tracker, registration, heartbeat, or analytics requests.
local function findExecutorHttpRequest()
    -- Some executors expose request globally but not through getgenv().
    for _, fn in pairs({request = request, http_request = http_request, httprequest = httprequest}) do
        if type(fn) == "function" then return fn end
    end
    local pools = {env, _G}
    for _, pool in ipairs(pools) do
        if type(pool) == "table" then
            for _, key in ipairs({"request", "http_request", "httprequest", "HTTP_REQUEST"}) do
                if type(pool[key]) == "function" then return pool[key] end
            end
            for _, key in ipairs({"syn", "http", "fluxus", "httpservice", "krnl"}) do
                local group = pool[key]
                if type(group) == "table" then
                    if type(group.request) == "function" then return group.request end
                    if type(group.Request) == "function" then return group.Request end
                end
            end
        end
    end
    return nil
end

