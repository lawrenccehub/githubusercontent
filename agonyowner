local function onBossAttack(data)
if bossTimer.synced and bossTimer.phase ~= "Fight" then return end
if bossTimer.deadLock then return end
if type(data) ~= "table" then
return
end
if defeated then
return
end
lastCombatAt = os.clock()
updateBossPresence(true)
if not flags.boss
or type(data.Targets) ~= "table" then
return
end
local targets = {}
for _, x in ipairs(data.Targets) do
if typeof(x) == "Vector3" then
table.insert(targets, x)
end
end
if #targets == 0 then
return
end
local radius =
tonumber(data.Radius) or 12
local best = nil
local bestDist = -math.huge
for i = 1, 12 do
local a = i * math.pi / 6
local p = Vector3.new(
BOSS_POS.X + math.cos(a) * 48,
BOSS_POS.Y + HOVER_HEIGHT + 20,
BOSS_POS.Z + math.sin(a) * 48
)
local nearest = math.huge
for _, target in ipairs(targets) do
nearest = math.min(
nearest,
(
Vector2.new(p.X, p.Z)
-
Vector2.new(
target.X,
target.Z
)
).Magnitude - radius - 12
)
end
if nearest > bestDist then
best = p
bestDist = nearest
end
end
dodgePos = best
