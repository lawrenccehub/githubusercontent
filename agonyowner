-- V11.9.63: per-egg native hatch filters; only explicitly selected non-secret species.
-- Rainbow is the UI label; native tier is Shiny. No inventory deletion.
do
    local row = card(pages.Egg, "Auto Delete Pet")
    local selector = rightButton(card(pages.Egg, "Delete Rarities"), "SELECT")
    local mutationSelector = rightButton(card(pages.Egg, "Delete Mutations"), "SELECT")
    local rarityNames = {"Common","Rare","Epic","Legendary","Mythical","Godly"}
    local tierNames = {"Normal","Golden","Diamond","Shiny"}
    local tierLabels = {Normal="Normal",Golden="Gold",Diamond="Diamond",Shiny="Rainbow"}
    local ranks = {Common=true,Rare=true,Epic=true,Legendary=true,Mythical=true,Godly=true}
    local tiers = {Normal=true,Golden=true,Diamond=true,Shiny=true}
    local picked, pickedTiers = {}, {}
    local rarity, mutationSetting = "", ""
    local optionButtons, tierButtons
    local enabled, dirty, scheduled, pending = false, false, false, nil
    local managed, cache = {}, {}
    local setDelete
    local function module(name,path)
        if cache[name] then return cache[name] end
        local obj=getRemote(path,"ModuleScript")
        if not obj then return nil end
        local ok,value=pcall(require,obj)
        if ok and type(value)=="table" then cache[name]=value; return value end
    end
    local function read(egg, want)
        local dc=module("data",{"Controllers","Core","DataController"})
        local catalog=module("eggs",{"Shared","Pets","LaunchEggConfig"})
        local pets=module("pets",{"Shared","Pets","LaunchPetConfig"})
        local rules=module("rules",{"Shared","Pets","HatchRulesConfig"})
        if not (dc and catalog and pets and rules and type(rules.AutoDeleteKey)=="function") then return nil end
        local replica=dc:GetReplica()
        local data=replica and replica.Data
        local ed=data and data.Eggs
        local cfg=catalog[egg]
        if type(ed)~="table" or type(ed.AutoDelete)~="table" or type(cfg)~="table" or type(cfg.Pets)~="table" then return nil end
        local entries=ed.AutoDelete[egg] or {}
        if type(entries)~="table" then return nil end
        local keys={}
        if want then
            for name in pairs(cfg.Pets) do
                local pet=pets[name]
                local rank=type(pet)=="table" and pet.Rarity
                if rank=="Basic" then rank="Common" elseif rank=="Mythic" then rank="Mythical" end
                if type(name)=="string" and picked[rank] and not (type(cfg.Secrets)=="table" and cfg.Secrets[name]~=nil) then
                    for tier in pairs(pickedTiers) do
                        if table.find(rules.AutoDeleteTiers or {},tier) then
                            local key=rules.AutoDeleteKey(name,tier)
                            if type(key)=="string" then keys[key]=true end
                        end
                    end
                end
            end
        end
        return entries,keys
    end
    local function safeRead(egg,want)
        local ok,a,b=pcall(read,egg,want)
        if ok then return a,b end
    end
    local function sameSet(a,b)
        for k in pairs(a) do if not b[k] then return false end end
        for k in pairs(b) do if not a[k] then return false end end
        return true
    end
    local function entrySet(entries)
        local out={}
        for _,key in ipairs(entries) do out[key]=true end
        return out
    end
    local function syncEgg(egg,want)
        local entries,desired=safeRead(egg,want)
        if not entries then warn("[AGONY AUTO DELETE] Data unavailable",egg); return false end
        if not alive then return false end
        -- Module loading can yield. Re-evaluate the current selection before sending.
        if want ~= (enabled and egg==eggSelected) then dirty=true; return false end
        local before=entrySet(entries)
        local previous=managed[egg] or {}
        local output,seen={},{}
        for _,key in ipairs(entries) do
            if (not previous[key] or desired[key]) and not seen[key] then
                table.insert(output,key); seen[key]=true
            end
        end
        for key in pairs(desired) do
            if not seen[key] then table.insert(output,key); seen[key]=true end
        end
        if sameSet(before,seen) then managed[egg]=next(desired) and desired or nil; return true end
        local remote=getRemote({"RemoteServices","EggService","RE","AutoDeleteRequested"},"RemoteEvent")
        if not remote then warn("[AGONY AUTO DELETE] Remote unavailable"); return false end
        local ok=pcall(function() remote:FireServer({Egg=egg,Entries=output}) end)
        if not ok then warn("[AGONY AUTO DELETE] Request failed"); return false end
        managed[egg]=next(desired) and desired or nil
        local changed={}
        for k in pairs(before) do if not seen[k] then changed[k]=false end end
        for k in pairs(seen) do if not before[k] then changed[k]=true end end
        pending={egg=egg,changed=changed,deadline=os.clock()+5}
        return true
    end
    local function runSync()
        if pending or not dirty or not alive then return end
        dirty=false
        -- Clearing old managed keys prevents stale filters after selection change.
        for egg in pairs(managed) do
            if not enabled or egg~=eggSelected then
                if not syncEgg(egg,false) then return end
                if pending then dirty=true; return end
            end
        end
        if enabled then syncEgg(eggSelected,true) end
    end
    local function queueSync()
        dirty=true
        if scheduled then return end
        scheduled=true
        task.defer(function()
            local ok,err=pcall(runSync)
            scheduled=false
            if not ok then warn("[AGONY AUTO DELETE]",tostring(err)) end
        end)
    end
    local function redraw(names,selection,buttons,anchor,labels)
        local list={}
        for _,name in ipairs(names) do
            local display=labels and labels[name] or name
            if selection[name] then table.insert(list,name) end
            if buttons and buttons[name] then
                buttons[name].Text=display
                buttons[name].BackgroundColor3=selection[name] and C.green or C.side
            end
        end
        if buttons and buttons.__all then
            buttons.__all.BackgroundColor3=#list==#names and C.green or C.side
        end
        anchor.Text=#list==0 and "SELECT" or (#list==#names and ("ALL ("..#names..")")
            or (#list==1 and (labels and labels[list[1]] or list[1]) or (#list.." selected")))
        return table.concat(list,",")
    end
    local function paint()
        rarity=redraw(rarityNames,picked,optionButtons,selector)
        mutationSetting=redraw(tierNames,pickedTiers,tierButtons,mutationSelector,tierLabels)
        if enabled then queueSync() end
    end
    local function choices(names,labels)
        local out={{label="SELECT ALL",value="__all"}}
        for _,name in ipairs(names) do table.insert(out,{label=labels and labels[name] or name,value=name}) end
        return out
    end
    local function pick(value,selection,names,valid)
        if value=="__all" then
            local all=true
            for _,name in ipairs(names) do if not selection[name] then all=false end end
            for _,name in ipairs(names) do selection[name]=not all or nil end
        elseif valid[value] then selection[value]=not selection[value] or nil end
        paint()
    end
    optionButtons=dropdown(selector,choices(rarityNames),function(v) pick(v,picked,rarityNames,ranks) end,true)
    tierButtons=dropdown(mutationSelector,choices(tierNames,tierLabels),function(v) pick(v,pickedTiers,tierNames,tiers) end,true)
    setDelete=toggle(row,function(v)
        enabled=v
        queueSync()
    end)
    settingsUI.setDeleteEnabled=setDelete
    settingsUI.getDeleteEnabled=function() return enabled end
    settingsUI.getDeleteRarity=function() return rarity end
    settingsUI.getDeleteMutation=function() return mutationSetting end
    local function parse(value,valid,isTier)
        local result={}
        for name in tostring(value or ""):gmatch("[^,]+") do
            name=name:match("^%s*(.-)%s*$")
            if isTier then
                if name=="Gold" then name="Golden" elseif name=="Rainbow" then name="Shiny" end
            elseif name=="Mythic" then name="Mythical" end
            if valid[name] then result[name]=true end
        end
        return result
    end
    settingsUI.setDeleteRarity=function(v) picked=parse(v,ranks,false); paint() end
    settingsUI.setDeleteMutation=function(v) pickedTiers=parse(v,tiers,true); paint() end
    paint()
    local lastEgg=eggSelected
    task.spawn(function()
        while alive do
            if lastEgg~=eggSelected then lastEgg=eggSelected; if enabled then queueSync() end end
            if pending and not scheduled then
                local entries=safeRead(pending.egg,false)
                if entries then
                    local state=entrySet(entries)
                    local accepted=true
                    for key,expected in pairs(pending.changed) do
                        if (state[key]==true)~=expected then accepted=false; break end
                    end
                    if accepted then pending=nil end
                end
                if pending and os.clock()>=pending.deadline then
                    warn("[AGONY AUTO DELETE] Game did not confirm filter update",pending.egg)
                    pending=nil
                end
            end
            if dirty and not pending and not scheduled then queueSync() end
            task.wait(0.2)
        end
    end)
end

