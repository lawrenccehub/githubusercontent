-- The game's TapChestController uses CollectionService + TapChestService:Claim(Id).
-- No generic name-based chest scanning, portal clicking, or mining teleports.
do
    local CollectionService = game:GetService("CollectionService")
    local questStatus = {Text = "Ready"} -- internal only; no Main page status row
    local chestStatus = {Text = "Ready"} -- internal only; no Main page status row

    local function setStatus(widget, value)
        if alive and widget then widget.Text = tostring(value) end
    end

    local serviceCache = {}
    local function commService(name)
        if serviceCache[name] then return serviceCache[name] end
        local ok, obj = pcall(function()
            local clientComm = require(RS.Packages.Comm).ClientComm
            return clientComm.new(RS.RemoteServices, false, name):BuildObject()
        end)
        if ok and obj then serviceCache[name] = obj; return obj end
        return nil
    end

    local function invokeClaim(serviceName, method, payload)
        local service = commService(serviceName)
        if service then
            local f = service[method]
            if type(f) == "function" then
                return pcall(function() return f(service, payload) end)
            end
        end
        local direct = getRemote({"RemoteServices", serviceName, "RF", method}, "RemoteFunction")
        if direct then return pcall(function() return direct:InvokeServer(payload) end) end
        return false, "METHOD UNAVAILABLE"
    end

    -- QUEST CLAIM V11.9.13: exact names verified in Dex QuestService/RF.
    -- ClaimAllQuests is a RemoteFunction; QuestAutoClaimed is a server event,
    -- so we never FireServer on QuestAutoClaimed.
    local questBusy = false
    local lastQuestCall = -math.huge
    local lastQuestDiagnostic = ""
    local lastQuestConfirmed = -math.huge
    local questListFromSpy = {
        "EndlessRebirths1", "EndlessRebirths2", "EndlessRebirths3",
        "EndlessRebirths4", "EndlessRebirths5", "ShadowRealmPortal",
        "CrystalCavePortal", "DesertPortal", "MushroomPortal", "AutumnPortal"
    }

    local function questPanel()
        local hud = pg:FindFirstChild("RightHud")
        local main = hud and hud:FindFirstChild("Main")
        local right = main and main:FindFirstChild("RightUI")
        return (right and right:FindFirstChild("Quests")) or pg:FindFirstChild("Quests", true)
    end

    local function readyQuest(entry)
        if type(entry) ~= "table" then return false end
        if entry.Claimed == true or entry.IsClaimed == true
            or entry.RewardClaimed == true or entry.Collected == true then return false end
        for _, key in ipairs({"CanClaim", "Claimable", "ReadyToClaim", "Ready", "Completed"}) do
            if entry[key] == true then return true end
        end
        local state = tostring(entry.State or entry.Status or ""):lower()
        if state == "claimable" or state == "ready" or state == "completed" then return true end
        local progress = tonumber(entry.Progress or entry.Count or entry.Current)
        local target = tonumber(entry.Required or entry.Goal or entry.Target)
        return progress ~= nil and target ~= nil and target > 0 and progress >= target
    end

    -- V11.9.13: follow the actual QuestController:countReady() test.
    -- The game checks Data.Quests[id].Amount against Definitions[id].Goal,
    -- not generic Progress/Current, and skips AutoClaim/hidden quests.
    local function gatherQuestNames()
        local ids = {}
        local success, data, definitions, visibility = pcall(function()
            local repl = require(RS.Controllers.Core.DataController):GetReplica()
            if not repl then return nil end
            local cfg = require(RS.Shared.Quests.QuestConfig)
            local shown = require(RS.Shared.Quests.QuestVisibility)
            return repl.Data, cfg.Definitions, shown
        end)
        if success and type(data) == "table"
            and type(data.Quests) == "table"
            and type(definitions) == "table" then
            for id, record in pairs(data.Quests) do
                local def = definitions[id]
                if type(id) == "string" and type(record) == "table"
                    and type(def) == "table" and def.AutoClaim ~= true
                    and record.Claimed ~= true then
                    local isShown = true
                    if type(visibility) == "table" and type(visibility.IsShown) == "function" then
                        local ok, shown = pcall(visibility.IsShown, data, id)
                        isShown = ok and shown == true
                    end
                    if isShown and (record.Completed == true
                        or (tonumber(record.Amount) or 0) >=
                        (tonumber(def.Goal) or math.huge)) then
                        table.insert(ids, id)
                    end
                end
            end
        end
        table.sort(ids)
        return ids, success and "QUEST DATA" or "DATA UNAVAILABLE"
    end

    -- Avoid an indefinitely-yielding RemoteFunction locking Auto Quest forever.
    -- The request is still managed by the Roblox server; a timeout does NOT
    -- mean a reward was or was not granted.
    local function invokeQuest(remote, arg, hasArgument)
