    -- The measured CFrames face the portal. Back away on the horizontal
    -- plane rather than landing at its entrance; preserve position height
    -- and facing. This applies only to Auto Buy, not manual island travel.
    local PORTAL_BACKOFF = 6
    local function portalStandFor(world, islandName, attempt)
        local worldSet = portalStandOverrides[world]
        local measured = worldSet and worldSet[islandName]
        if not measured then return nil end
        local look = measured.LookVector
        local forward = Vector3.new(look.X, 0, look.Z)
        if forward.Magnitude < 0.01 then return nil end
        -- Rift coordinates were measured beside the portals, not at their
        -- center. A smaller backoff avoids placing the avatar out of range.
        local backoff = world == "TimeRift" and 0 or PORTAL_BACKOFF
        -- Rift uses the measured location to allow the native encounter.
        -- Retain the World 1 retry offset unchanged.
        if world == "Main" and (attempt or 0) > 0 then backoff = 1.5 end
        return measured - forward.Unit * backoff
    end
    local function approachDrifted(a)
        if not a or not a.root then return true end
        if a.part and (not a.part:IsDescendantOf(workspace)
            or (a.root.Position-a.part.Position).Magnitude > 14) then return true end
        if not a.stand then return false end
        local d = a.root.Position-a.stand.Position
        -- Restore the previous 16-stud combined landing tolerance.
        -- Do not reset merely because the root settles onto the platform.
        return d.Magnitude > 16
    end
    local function inRiftArea(root)
        if not root then return false end
        local config = readModule("RiftIslandConfig", {"Shared", "Progression", "RiftIslandConfig"})
        if not config or type(config.AreaAt) ~= "function" then return false end
        local ok, area = pcall(config.AreaAt, root.Position)
        return ok and type(area) == "string" and area ~= ""
    end
    local function standNear(part, r, h)
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances={player.Character,part}
        params.RespectCanCollide=true
        params.IgnoreWater=true
        local origin=part.Position
        local look=part.CFrame.LookVector
        local flat=Vector3.new(look.X,0,look.Z)
        if flat.Magnitude<0.1 then flat=Vector3.new(0,0,-1) end
        for _, clearance in ipairs({7, 9}) do
            local pos=origin+flat.Unit*clearance
            local hit=workspace:Raycast(pos+Vector3.new(0,12,0),Vector3.new(0,-28,0),params)
            if hit and hit.Normal.Y>0.6 and not has(hit.Instance.Name,"lava") then
                local landing=hit.Position+Vector3.new(0,h.HipHeight+r.Size.Y/2+0.25,0)
                if (landing-origin).Magnitude<=12 then return CFrame.lookAt(landing,Vector3.new(origin.X,landing.Y,origin.Z)) end
            end
        end
        return nil
    end
    local function halt(message, color)
        -- Keep the requested toggle/config ON; park the worker safely after
        -- failures instead of repeatedly sending requests. OFF/ON retries.
        parked = true
        releaseApproach()
        restoreConfirm()
        say(message:gsub(": OFF$", ": PAUSED"), color)
    end
    setBuy = toggle(row, function(value)
        enabled = value
        parked, completed = false, false
        wildWestExpected, wildWestConfirm = false, nil
        if value then
            approachKey, approachCount, entranceCount = nil, 0, 0
            clearRiftEntry()
            if not pending then riftResult, riftTravelDeadline = nil, nil end
            say(pending and "Awaiting prior buy" or "Checking...", C.muted)
        else
            timeRiftApproached = false
            clearRiftEntry()
            riftEntranceRoot, riftEntranceAt = nil, -math.huge
            riftTransferRoot, riftTransferAt = nil, -math.huge
            restoreConfirm()
            releaseApproach()
            say(pending and "OFF / pending" or "OFF", C.muted)
        end
    end)
