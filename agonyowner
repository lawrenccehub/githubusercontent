        return enabled and not completed
    end
    -- Read only this account's server-replicated progression, not the
    -- copied config's owner's progress. Never start hatching a locked egg.
    settingsUI.canHatchEgg = function(egg)
        if settingsUI.islandBuyPriority() then return false, "ISLAND BUY FIRST" end
        local data = readData()
        local config = readModule("HatchEggs", {"Shared", "Pets", "LaunchEggConfig"})
        local def = config and config[egg]
        if not data or type(def) ~= "table" then return false, "WAITING FOR UNLOCK DATA" end
        if def.World == "TimeRift" then
            local worlds = data.Progression.UnlockedWorlds
            if type(worlds) ~= "table" or worlds.TimeRift ~= true then return false, "TIME RIFT LOCKED" end
        end
        local island = def.Island
        if type(island) == "string" and island ~= "" and island ~= "Spawn" and island ~= "World 2 Spawn"
            and data.Progression.UnlockedIslands[island] ~= true then
            return false, "ISLAND LOCKED: " .. island
        end
        if settingsUI.islandBuyPriority() then return false, "ISLAND BUY FIRST" end
        return true
    end
