    local function readModule(key, path)
        if cache[key] then return cache[key] end
        local module = getRemote(path, "ModuleScript")
        if not module then return nil end
        local ok, result = pcall(require, module)
        if ok and type(result) == "table" then
            cache[key] = result
            return result
        end
        return nil
    end
    local function restoreConfirm()
        if confirmUI.controller and confirmUI.original then
            pcall(function()
                if confirmUI.controller.ShowConfirm == confirmUI.wrapper then
                    confirmUI.controller.ShowConfirm = confirmUI.original
                end
            end)
        end
        confirmUI = {}
        riftConfirm = nil
        wildWestConfirm = nil
    end
    local function installConfirm()
        if not alive or not enabled then return false end
        if confirmUI.controller and confirmUI.controller.ShowConfirm == confirmUI.wrapper then return true end
        restoreConfirm()
        local controller = readModule("Confirm", {"Controllers", "UI", "MessageController"})
        if not alive or not enabled then return false end
        if not controller or type(controller.ShowConfirm) ~= "function" then return false end
        local original = controller.ShowConfirm
        local wrapper = function(self, options, ...)
            if alive and enabled and type(options) == "table" and type(options.Description) == "string" then
                local description = options.Description:lower()
                -- Only the pictured unlock-island dialog; never suppress zones,
                -- other purchase dialogs, Robux prompts, or unrelated messages.
                if description:find("unlock", 1, true) and description:find("island", 1, true) then
                    local name = approach and approach.name or pending and pending.Name
                    local function matches(island)
                        if type(island) ~= "string" then return false end
                        local needle = island:lower()
                        return description:find('"' .. needle .. '"', 1, true) ~= nil
                    end
                    local awaitingMedieval = pending and pending.Name == "Medieval Island"
                    if (wildWestExpected or awaitingMedieval) and not parked
                        and (not pending or awaitingMedieval)
                        and player:GetAttribute("World") == "TimeRift" and matches("Wild West") then
                        local root = currentRoot()
                        if root and type(options.OnConfirm) == "function" then
                            wildWestExpected = true
                            wildWestConfirm = {Name="Wild West", Root=root, Stand=root.CFrame,
                                Callback=options.OnConfirm, At=os.clock()}
                            consolePrint("[AGONY AUTO BUY ISLAND] Native Wild West confirmation captured")
                            return true
                        end
                        return original(self, options, ...)
                    end
                    if approach and approach.world == "TimeRift" and matches(approach.name) then
                        -- Rift uses its actual native confirmation, not an assumed
                        -- World 1 remote payload. If the dialog has no callback,
                        -- leave it visible for the player instead of suppressing it.
                        if type(options.OnConfirm) == "function" then
                            if not pending and not riftConfirm then
                                riftConfirm = {Name=approach.name, Root=approach.root,
                                    Callback=options.OnConfirm, At=os.clock()}
                                consolePrint("[AGONY AUTO BUY ISLAND] Native Rift confirmation:", approach.name)
                            end
                            return true
                        end
                        return original(self, options, ...)
                    end
                    if matches(name) or (os.clock() - lastBoughtAt < 9 and matches(lastBoughtName)) then
                        -- World 1 worker owns this purchase.
                        return true
                    end
                end
            end
            return original(self, options, ...)
        end
        local ok = pcall(function() controller.ShowConfirm = wrapper end)
        if ok and controller.ShowConfirm == wrapper then
            confirmUI = {controller=controller, original=original, wrapper=wrapper}
            return true
        end
        return false
    end
