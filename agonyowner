    -- Observe confirmed system chat about this account only; never forward
    -- ordinary user chat. Deduplicate by the actual message ID when available.
    -- A successful structured notification suppresses at most one matching
    -- chat notification, NOT every hatch in the same time window.
    do
        local chat = game:GetService("TextChatService")
        local function containsWord(text, value)
            local escaped = value:lower():gsub("([^%w_])", "%%%1")
            return text:find("%f[%w_]" .. escaped .. "%f[^%w_]") ~= nil
        end
        local function observeHatchMessage(message)
            if not alive or not webhook.enabled or not message then return end
            if message.TextSource ~= nil then return end
            local raw = tostring(message.Text or ""):gsub("<[^>]*>", ""):gsub("[%c]", " ")
            local lower = raw:lower()
            local name = player.Name:lower():gsub("([^%w_])", "%%%1")
            local suffix = lower:match("%f[%w_]" .. name .. "%f[^%w_]([%s%p].*)")
            if not suffix then return end
            suffix = suffix:gsub("^[%s:!%-]+", "")
                :gsub("^has%s+", ""):gsub("^just%s+", "")
            -- Do not accept a random username mention; require a hatch verb
            -- immediately after the subject and a confirmed Secret rarity.
            local action = suffix:match("^(%a+)%s+")
            if not ({hatched=true, obtained=true, got=true, found=true, unboxed=true})[action]
                or not containsWord(suffix, "secret") then return end
            local stamp = os.clock()
            local messageId = tostring(message.MessageId or "")
            local dedupKey = messageId ~= "" and ("chat-id:" .. messageId) or ("chat-text:" .. raw:sub(1, 500))
            if webhook.seen[dedupKey] and stamp - webhook.seen[dedupKey] < (messageId ~= "" and 180 or 0.75) then return end
            webhook.seen[dedupKey] = stamp
            for key, seenAt in pairs(webhook.seen) do
                if stamp - seenAt > 180 then webhook.seen[key] = nil end
            end
            webhook.chatSequence += 1
            local eventId = dedupKey .. ":" .. tostring(webhook.chatSequence)
            task.delay(6, function()
                if not alive or not webhook.enabled then return end
                local best, bestDistance
                for _, recent in pairs(webhook.recentStructured) do
                    local distance = math.abs(recent.at - stamp)
                    if recent.delivered and not recent.chatMatched and distance <= 10
                        and recent.petName and containsWord(lower, recent.petName)
                        and (not bestDistance or distance < bestDistance) then
                        best, bestDistance = recent, distance
                    end
                end
                if best then best.chatMatched = true; return end
                local payload = secretEmbed({Egg = "Unknown", Rarity = "Secret"},
                    player.UserId, player.Name, nil, nil, nil, nil, nil)
                payload.embeds[1].description = "**OWN SECRET HATCH (SYSTEM CHAT)**\n" .. raw:sub(1, 500)
                pushMessage(payload, eventId)
            end)
        end
        local ok = pcall(function()
            on(chat.MessageReceived, function(message)
                local good, err = pcall(observeHatchMessage, message)
                if not good then warn("[AGONY WEBHOOK] Chat observer:", tostring(err):sub(1, 120)) end
            end)
        end)
        webhook.chatListening = ok
    end

