    local function readData()
        local dc = readModule("Data", {"Controllers", "Core", "DataController"})
        if not dc then return nil end
        local ok, result = pcall(function() return dc:GetReplica().Data end)
        if ok and type(result) == "table" and type(result.Progression) == "table"
            and type(result.Progression.UnlockedIslands) == "table" then
