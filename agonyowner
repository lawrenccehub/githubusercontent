-- =============================================================
-- V11.9.53: Portable full-config sharing across Roblox accounts.
-- AGONYCFG2 exported verbose JSON with punctuation and line breaks. Some
-- clipboards, messaging apps and Roblox paste inputs altered/truncated it.
-- AGONYCFG4 packs ALL options into short positional data, uses URL-safe
-- Base64, and adds an Adler-32 checksum to detect incomplete transfers.
-- No player.UserId is baked into the sharing code. File saves remain
-- account-local by design, but a copied config imports on any account.
-- Legacy AGONYCFG2/AGONYCFG1/AG2 imports remain supported.
-- =============================================================
local SHARED_PREFIX = "AGONYCFG4-"
local SHARED_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
local SHARED_MAIN_KEYS = {"best", "tap", "chest", "quest", "rebirth", "boss"}

local function sharedHasBit(value, bit)
    return math.floor(value / (2 ^ bit)) % 2 == 1
end

local function sharedChecksum(source)
    local a, b = 1, 0
    for i = 1, #source do
        a = (a + source:byte(i)) % 65521
        b = (b + a) % 65521
    end
    return string.format("%08X", b * 65536 + a)
end

local function sharedEncode64(source)
    local result = {}
    for i = 1, #source, 3 do
        local a, b, c = source:byte(i, i + 2)
        local value = a * 65536 + (b or 0) * 256 + (c or 0)
        local p = math.floor(value / 262144) % 64
        local q = math.floor(value / 4096) % 64
        local r = math.floor(value / 64) % 64
        local t = value % 64
        result[#result + 1] = SHARED_ALPHABET:sub(p + 1, p + 1)
        result[#result + 1] = SHARED_ALPHABET:sub(q + 1, q + 1)
        if b then result[#result + 1] = SHARED_ALPHABET:sub(r + 1, r + 1) end
        if c then result[#result + 1] = SHARED_ALPHABET:sub(t + 1, t + 1) end
    end
    return table.concat(result)
end

local sharedLookup = {}
for i = 1, #SHARED_ALPHABET do
    sharedLookup[SHARED_ALPHABET:sub(i, i)] = i - 1
end
local function sharedDecode64(source)
    if #source == 0 or #source % 4 == 1 then return nil end
    local result = {}
    for i = 1, #source, 4 do
        local x, y, z, w = source:sub(i, i), source:sub(i + 1, i + 1),
            source:sub(i + 2, i + 2), source:sub(i + 3, i + 3)
        local a, b = sharedLookup[x], sharedLookup[y]
        local c = (z == "") and 0 or sharedLookup[z]
        local d = (w == "") and 0 or sharedLookup[w]
        if a == nil or b == nil or c == nil or d == nil then return nil end
        local value = a * 262144 + b * 4096 + c * 64 + d
        result[#result + 1] = string.char(math.floor(value / 65536) % 256)
        if z ~= "" then result[#result + 1] = string.char(math.floor(value / 256) % 256) end
        if w ~= "" then result[#result + 1] = string.char(value % 256) end
    end
    return table.concat(result)
end

local function sharedEncodeConfig(config)
    local main, opts = 0, 0
    local trade = type(config.Trade) == "table" and config.Trade or {}
    local webhook = type(config.Webhook) == "table" and config.Webhook or {}
    for i, key in ipairs(SHARED_MAIN_KEYS) do
        if type(config.Main) == "table" and config.Main[key] == true then
            main += 2 ^ (i - 1)
        end
    end
    local switches = {
        config.AutoEgg, config.AutoEvent, config.InfiniteJump,
        config.Optimizer, config.AutoLoad, config.HideEggAnimation,
        config.HideDamage, config.AutoHoldReveal, config.SkipSecretCutscene,
        config.AutoSkillTree, config.AutoShrine, config.AntiAFK,
        trade.AutoTrade, trade.AutoAcceptTrade, webhook.Enabled,
        config.HideTap
    }
    for i = 1, 16 do
        if switches[i] == true then opts += 2 ^ (i - 1) end
    end
    local packed = {
        4, tostring(config.ConfigName or "Default"), main, opts,
        tonumber(trade.TargetUserId) or 0,
        tostring(trade.TargetUsername or ""),
        tostring(webhook.URL or ""),
        tostring(config.Island or "Spawn"),
        tostring(config.Egg or "Basic"),
        tostring(trade.Rarity or "Secret"),
        tostring(config.ShrineBlessing or "Golden"),
        tostring(config.DeleteRarity or ""),
        tostring(config.DeleteMutation or ""),
        config.AutoClaimIndex == true, config.HideIndexRewards ~= false,
        config.AutoBuyIsland == true,
        config.AutoDeleteEnabled == true
    }
    local json = Http:JSONEncode(packed)
    return SHARED_PREFIX .. sharedEncode64(json) .. "-" .. sharedChecksum(json)
end

local function sharedDecodeConfig(input)
    if type(input) ~= "string" or input:match("^%s*$") then
        return nil, "EMPTY CODE"
    end
    local code = input:match("^%s*(.-)%s*$")
    -- Accept copy/paste from Markdown code blocks and wrapped messages.
    if code:sub(1, 3) == "```" then
        code = code:gsub("^```[^\n]*\n", ""):gsub("%s*```%s*$", "")
    end
    code = code:match("^%s*(.-)%s*$")
    -- Allow Discord backticks and accidental wrapping/newlines in a code.
    code = code:gsub("^`+", ""):gsub("`+$", "")
    code = code:match("^%s*(.-)%s*$")
    if code:sub(1, #SHARED_PREFIX):upper() == SHARED_PREFIX or code:sub(1, 10):upper() == "AGONYCFG3-" then
        -- Spaces and newlines may be inserted by phone/Discord paste.
        -- A damaged/truncated payload still fails the checksum safely.
        local compact = code:gsub("[%s`]", "")
        if compact:sub(1, #SHARED_PREFIX):upper() == SHARED_PREFIX then
            compact = SHARED_PREFIX .. compact:sub(#SHARED_PREFIX + 1)
        elseif compact:sub(1, 10):upper() == "AGONYCFG3-" then
            compact = "AGONYCFG3-" .. compact:sub(11)
        end
        if #compact > 16000 then return nil, "CODE TOO LONG" end
        local payload, sum = compact:match("^AGONYCFG4%-([A-Za-z0-9_-]+)%-([0-9A-Fa-f]+)$")
        if not payload or not sum or #sum ~= 8 then
            payload, sum = compact:match("^AGONYCFG3%-([A-Za-z0-9_-]+)%-([0-9A-Fa-f]+)$")
        end
        if not payload or not sum or #sum ~= 8 then
            return nil, "CODE CUT OFF"
        end
        local json = sharedDecode64(payload)
        if not json then return nil, "BAD CODE TEXT" end
        if sharedChecksum(json) ~= sum:upper() then
            return nil, "CODE DAMAGED"
        end
        local ok, packed = pcall(function() return Http:JSONDecode(json) end)
        if not ok or type(packed) ~= "table" or (packed[1] ~= 3 and packed[1] ~= 4)
            or type(packed[2]) ~= "string" or type(packed[3]) ~= "number"
            or type(packed[4]) ~= "number" or type(packed[6]) ~= "string"
            or type(packed[7]) ~= "string" or type(packed[8]) ~= "string"
            or type(packed[9]) ~= "string"
            or packed[3] < 0 or packed[3] > 63
            or packed[4] < 0 or packed[4] >= 65536 then
            return nil, "BAD CODE DATA"
        end
        local main = {}
        for i, key in ipairs(SHARED_MAIN_KEYS) do
            main[key] = sharedHasBit(packed[3], i - 1)
        end
        local bit = function(index) return sharedHasBit(packed[4], index) end
        local uid = tonumber(packed[5]) or 0
        local buyPreference
        if packed[1] == 4 and type(packed[16]) == "boolean" then buyPreference = packed[16] end
        return {
            Version = "11.9.79",
            ConfigName = packed[2],
            Main = main,
            Trade = {
                TargetUserId = uid > 0 and uid or nil,
                TargetUsername = packed[6],
                Rarity = type(packed[10]) == "string" and packed[10] or "Secret",
                AutoTrade = bit(12), AutoAcceptTrade = bit(13)
            },
            Webhook = {URL = packed[7], Enabled = bit(14)},
            Island = packed[8], Egg = packed[9],
            ShrineBlessing = ({Golden = true, Luck = true, AutoClicker = true})[packed[11]] and packed[11] or "Golden",
            DeleteRarity = type(packed[12]) == "string" and packed[12] or "",
            DeleteMutation = packed[1] == 4 and type(packed[13]) == "string" and packed[13] or (packed[1]==3 and "Normal" or ""),
            AutoClaimIndex = (packed[1] == 4 and packed[14] == true) or (packed[1] == 3 and packed[13] == true),
            HideIndexRewards = (packed[1] == 4 and packed[15] ~= false) or (packed[1] == 3 and packed[14] ~= false),
            AutoEgg = bit(0), AutoEvent = false,
            AutoBuyIsland = buyPreference,
            AutoDeleteEnabled = packed[1] == 4 and packed[17] == true,
            InfiniteJump = bit(2), Optimizer = bit(3),
            AutoLoad = bit(4), HideEggAnimation = bit(5),
            HideDamage = bit(6), AutoHoldReveal = bit(7),
            SkipSecretCutscene = bit(8), AutoSkillTree = bit(9),
            AutoShrine = bit(10), AntiAFK = bit(11), HideTap = bit(15)
        }, nil
    end
    -- Old copy codes still import if intact. Raw JSON contains punctuation,
    -- so we must NOT strip its internal whitespace or change its case.
    local head = code:sub(1, 10):upper()
    if head == "AGONYCFG2|" or head == "AGONYCFG1|" then
        local ok, decoded = pcall(function()
            return Http:JSONDecode(code:sub(11))
        end)
        if not ok or type(decoded) ~= "table" or type(decoded.Config) ~= "table" then
            return nil, "OLD CODE CUT"
        end
        local data = decoded.Config
        if type(decoded.Name) == "string" then data.ConfigName = decoded.Name end
        return data, nil
    end
    local legacy = settingsUI.decodeCompact(code:upper())
    if legacy then return legacy, nil end
    return nil, "INVALID CODE"
end

