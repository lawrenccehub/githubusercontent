        end
        return chestId
    end

    local function chestAnchor(model)
        local anchor = model.PrimaryPart or model:FindFirstChild("RootPart", true)
        if anchor and anchor:IsA("BasePart") then return anchor end
        return model:FindFirstChildWhichIsA("BasePart", true)
    end

    local function claimTapChest(model, id, active)
        if busyMovement or not active() or eggMode or bossFighting then return end
        chestBusy = true
        busyMovement = true
        local ok, err = pcall(function()
            local r, h = currentRoot(), currentHum()
            local anchor = chestAnchor(model)
            if not r or not h or h.Health <= 0 or not anchor then
                setStatus(chestStatus, "NO CHARACTER")
                return
            end
            -- Chest-specific target: controller creates a RootPart at the chest FRONT.
            -- Never teleport to an untagged model, portal, or mining entrance.
            local goal = anchor.Position + Vector3.new(0, 3, 0)
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
            r.CFrame = CFrame.new(goal, anchor.Position)
            if not waiting(active, 0.22) or not model.Parent or eggMode or bossFighting then return end
            setStatus(chestStatus, "CLAIMING")
