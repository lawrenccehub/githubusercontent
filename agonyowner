-- V11.9.63: Index requests do not wait for animation or a result.
-- The shared Reward ScreenGui has no source marker; instant visual hiding applies to all rewards rendered there.
do
    local row = card(pages.Main, "Auto All Claim Index")
    row.LayoutOrder = 3
    local info = {Text = "OFF"} -- internal status only; no UI row
    local enabled, hideRewards, sent, count = false, true, {}, 0
    local cache = {}
    local function load(key, path)
        if cache[key] then return cache[key] end
        local m = getRemote(path, "ModuleScript")
        if not m then return nil end
        local ok, v = pcall(require, m)
        if ok and type(v) == "table" then cache[key] = v; return v end
    end
    -- V11.9.77: the game's Reward controller Close() has a hard-coded
    -- 0.7s minimum delay.  Instead, suppress only the shared Reward ScreenGui
    -- as soon as it becomes enabled.  No simulated screen taps and no
    -- additional server requests.  This is INSTANT VISUAL HIDING, not a
    -- native Close() call; all rewards displayed by this shared GUI are hidden.
    local watchedReward = nil
    local function concealReward(gui)
        if not alive or not hideRewards or not gui or not gui.Parent then return end
        if not gui:IsA("ScreenGui") or gui.Name ~= "Reward" or not gui.Enabled then return end
        gui.Enabled = false
        -- The native Show() raises ScreenGlow after it enables Reward.  Reset
        -- the visual layer now and once after Show() has finished updating it.
        local glow = pg:FindFirstChild("ScreenGlow")
        if glow and glow:IsA("ScreenGui") then glow.DisplayOrder = -1 end
        task.defer(function()
            if not alive or not hideRewards then return end
            if gui.Parent and gui.Enabled then gui.Enabled = false end
            local updatedGlow = pg:FindFirstChild("ScreenGlow")
            if updatedGlow and updatedGlow:IsA("ScreenGui") then
                updatedGlow.DisplayOrder = -1
            end
        end)
    end
    local function watchReward(child)
        if not child or not child:IsA("ScreenGui") or child.Name ~= "Reward" then return end
        if child == watchedReward then return end
        watchedReward = child
        on(child:GetPropertyChangedSignal("Enabled"), function()
            concealReward(child)
        end)
        concealReward(child)
    end
    on(pg.ChildAdded, watchReward)
    watchReward(pg:FindFirstChild("Reward"))
    local function showStatus(message)
        info.Text = message
    end
    local setIndex = toggle(row, function(v)
        enabled = v
        showStatus(v and "Checking..." or "OFF")
    end)
    settingsUI.indexIsOn = function() return enabled end
    settingsUI.indexHideIsOn = function() return true end -- legacy config compatibility
    settingsUI.setIndex = setIndex
    settingsUI.indexShutdown = function()
        enabled, hideRewards = false, false
        watchedReward = nil
    end
    -- Automatic visual suppression; do not block startup on a module require.
    -- Legacy HideIndexRewards=false is intentionally ignored.
    local function tick()
        local dc=load("data", {"Controllers","Core","DataController"})
        local index=load("index", {"Shared","Pets","PetIndexCatalog"})
        local pets=load("pets", {"Shared","Pets","LaunchPetConfig"})
        local remote=getRemote({"RemoteServices","PetIndexService","RE","PetRewardClaimRequested"},"RemoteEvent")
        if not (dc and index and pets and remote and type(index.Discovered)=="function") then
            showStatus("Waiting for data"); return 1
        end
        local replica=dc:GetReplica()
        local data=replica and replica.Data
        if type(data)~="table" or type(data.Pets)~="table" then showStatus("Waiting for data"); return 1 end
        -- No waiting for RewardClaimResult. Never treat a sent request as
        -- a successful reward; no per-pet claimed-state field was supplied.
        for name, def in pairs(pets) do
            if type(name)=="string" and type(def)=="table" then
                for _, tier in ipairs({"Normal","Golden","Diamond","Shiny"}) do
                    if not alive or not enabled then return 0.25 end
                    local key=name.."\0"..tier
                    if not sent[key] and index.Discovered(data.Pets,name,tier)==true then
                        sent[key]=true
                        local ok=pcall(function() remote:FireServer(name,tier) end)
                        if not ok then
                            setIndex(false); showStatus("Request failed"); return 0.5
                        end
                        count+=1
                        showStatus(tostring(count).." requests")
                        return 0.4
                    end
                end
            end
        end
        showStatus("Checked: "..tostring(count))
        return 5
    end
    task.spawn(function()
        while alive do
            local interval=0.25
            if enabled then
                local ok, result=pcall(tick)
                if not ok then setIndex(false); showStatus("Error: OFF"); warn("[AGONY INDEX]",result)
                elseif type(result)=="number" then interval=result end
            end
            local deadline=os.clock()+interval
            repeat task.wait(math.min(0.25,math.max(0.01,deadline-os.clock())))
            until not alive or os.clock()>=deadline
        end
    end)
end
