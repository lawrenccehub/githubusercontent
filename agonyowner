    local function addWatchName(name)
        if sessionArmed then
            tradeStatus("Cannot change pets during active trade", C.red)
            return
        end
        local key = normalizedPetName(name)
        if key == "" or #key > 80 then
            tradeStatus("Enter a valid pet name", C.red)
            return
        end
        if not watchedPetNames[key] then
            local count = 0
            for _ in pairs(watchedPetNames) do count += 1 end
            if count >= 30 then
                tradeStatus("Watch list limit is 30 names", C.red)
                return
            end
        end
        watchedPetNames[key] = name:match("^%s*(.-)%s*$")
        watchSearch.Text = ""
        clearRows(watchMatches)
        updateWatchList()
        tradeStatus("Watching " .. watchedPetNames[key] .. " (also future hatches)", C.green)
    end
    -- Legacy pet-picker implementation retained for compatibility but hidden.
    -- The catalog search provides a multi-pick list of pet TYPES, including
    -- pets never owned. The text ADD fallback supports pet names absent from
    -- the client's currently replicated catalog.
    local cachedCatalogNames = nil
    local function catalogNames()
        if cachedCatalogNames then return cachedCatalogNames end
        local seen, result = {}, {}
        local ok, catalog = pcall(function()
            return require(RS.Shared.Pets.OriginalPetCatalog)
        end)
        if ok and type(catalog) == "table" then
            for k, item in pairs(catalog) do
                local name = type(k) == "string" and k
                    or type(item) == "table" and item.Name or nil
                if type(name) == "string" and name ~= "" then
                    local key = normalizedPetName(name)
                    if not seen[key] then
                        seen[key] = true
                        table.insert(result, name)
                    end
                end
            end
        end
        local pets = ownedPets()
        if pets then
            for _, item in pairs(pets.Owned) do
                if type(item) == "table" and type(item.Name) == "string" then
                    local key = normalizedPetName(item.Name)
                    if not seen[key] then
                        seen[key] = true
                        table.insert(result, item.Name)
                    end
                end
            end
        end
        table.sort(result, function(a, b) return a:lower() < b:lower() end)
        cachedCatalogNames = result
        return result
    end
