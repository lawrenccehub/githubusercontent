local function isBossModel(object)
if not object
or not object:IsDescendantOf(workspace)
or not (
object:IsA("Model")
or object:IsA("BasePart")
) then
return false
end
if object.Name ~= "BlazingSovereignBoss"
and object.Name ~= "Blazing Sovereign" then
return false
end
local p = partPos(object)
if not p
or (
(p - BOSS_POS).Magnitude > 240
and (p - BOSS_ARENA).Magnitude > 240
) then
return false
end
if object:GetAttribute("Active") == false
or object:GetAttribute("Alive") == false then
return false
end
local h =
object:FindFirstChildOfClass(
"Humanoid"
)
if h then
return h.Health > 0
end
if object:IsA("BasePart") then
return object.Transparency < 0.95
end
local visible = 0
for _, part in ipairs(
object:GetDescendants()
) do
