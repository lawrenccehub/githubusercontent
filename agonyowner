    end
    local function worldAndBalance(data)
        local world = data.Progression.World
        if world == nil then world = "Main" end
        if world ~= "Main" and world ~= "TimeRift" then return nil end
        local config = readModule("World", {"Shared", "Progression", "WorldConfig"})
        if not config or type(config.Worlds) ~= "table" then return nil end
        local definition = config.Worlds[world]
        if type(definition) ~= "table" or type(definition.CoinsKey) ~= "string"
            or type(data.Currencies) ~= "table" then return nil end
        if world == "TimeRift" then
            local unlockedWorlds = data.Progression.UnlockedWorlds
            if type(unlockedWorlds) ~= "table" or unlockedWorlds.TimeRift ~= true then
                return nil
            end
        end
        local balance = tonumber(data.Currencies[definition.CoinsKey])
        -- The native WorldConfig.GetCoins returns zero for a missing currency.
        if world == "TimeRift" and balance == nil and data.Currencies[definition.CoinsKey] == nil then balance = 0 end
        if not balance or balance ~= balance or balance < 0 then return nil end
        return world, balance
    end
    local function getCatalog(world)
        if catalogs[world] then return catalogs[world] end
        local name = world == "Main" and "IslandConfig" or "RiftIslandConfig"
        local config = readModule(name, {"Shared", "Progression", name})
        if not config or type(config.Islands) ~= "table" then return nil end
        local ordered, seen = {}, {}
        for island, def in pairs(config.Islands) do
            if type(island) ~= "string" or type(def) ~= "table"
                or type(def.Order) ~= "number" or def.Order % 1 ~= 0 or def.Order < 1
                or type(def.Price) ~= "number" or def.Price ~= def.Price
                or def.Price <= 0 or def.Price == math.huge or seen[def.Order] then
                return nil
            end
            seen[def.Order] = true
            table.insert(ordered, {Name = island, Order = def.Order, Price = def.Price, PortalName = def.PortalName, Landing = def.Landing})
        end
        table.sort(ordered, function(a, b) return a.Order < b.Order end)
        if #ordered == 0 then return nil end
        for index, entry in ipairs(ordered) do
            if entry.Order ~= index then return nil end
        end
        catalogs[world] = ordered
        return ordered
    end
    local function releaseApproach()
