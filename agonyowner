            if not sent then
                setStatus(chestStatus, "CLAIM REMOTE ERROR")
                warn("[AGONY TAPCHEST]", reply)
            elseif type(reply) == "table" and reply.Success == true then
                setStatus(chestStatus, "CHEST CLAIMED")
            elseif type(reply) == "table" and reply.Success == false then
                setStatus(chestStatus, tostring(reply.Reason or "NOT READY"):sub(1, 22))
            else
                setStatus(chestStatus, "CLAIM REQUEST SENT")
            end
        end)
        if not ok then
            warn("[AGONY TAPCHEST]", err)
            setStatus(chestStatus, "CHEST ERROR")
        end
        busyMovement = false
        chestBusy = false
    end

    worker("chest", mainRows.chest, 1.5, function(active)
        if chestBusy then return end
        if eggMode or bossFighting or (flags.boss and bossPresent) then
            setStatus(chestStatus, "PAUSED")
            return
        end
        local cfg = getChestConfig()
        if not cfg then setStatus(chestStatus, "NO TAPCHEST CONFIG"); return end
        local tagged = CollectionService:GetTagged(cfg.Tag)
        if #tagged == 0 then setStatus(chestStatus, "NO TAPCHESTS"); return end
        local candidate, chestId
        local seenReady = 0
        local nearest = math.huge
        local r = currentRoot()
        for _, model in ipairs(tagged) do
            local id = validChest(model, cfg)
            if id then
                if chestReady(model, id, cfg) then
                    seenReady += 1
                    local anchor = chestAnchor(model)
                    if anchor and os.clock() - (chestLast[id] or -math.huge) > 8 then
                        local dist = r and (r.Position - anchor.Position).Magnitude or 0
                        if dist < nearest then
                            candidate, chestId, nearest = model, id, dist
                        end
                    end
                end
            end
        end
        if candidate and chestId ~= nil and not busyMovement then
            chestLast[chestId] = os.clock()
            task.spawn(function() claimTapChest(candidate, chestId, active) end)
        elseif seenReady > 0 then
            setStatus(chestStatus, "WAITING RETRY")
        else
            setStatus(chestStatus, "COOLDOWN / NOT READY")
        end
    end)
end
