local nextPlace=0
local function placeCycle()
    if not placeRequested or disposed then return false end
    if carrying()~=false then setStatus(placeStatusLabel,"Waiting for delivery");return false end
    local pack=ownedPack()
    if not pack then setStatus(placeStatusLabel,"No owned packs");return false end
    if os.clock()<nextPlace then return true end
    local plot=ownedPlot()
    local ground=plot and plot:FindFirstChild("Ground1")
    if not ground or not ground:IsA("BasePart") then setStatus(placeStatusLabel,"Own plot not loaded");nextPlace=os.clock()+2;return true end
    local hrp=root()
    if not hrp then return true end
    local size=ground.Size
    local position=ground.CFrame:PointToWorldSpace(Vector3.new((math.random()-.5)*size.X,size.Y/2,(math.random()-.5)*size.Z))
    setStatus(placeStatusLabel,"Moving to plot")
    local reached=tweenTo(CFrame.new(position+Vector3.new(0,3,0)), function()
        return placeRequested and not disposed and root()==hrp and ownedPlot()==plot and ground.Parent~=nil and pack.Parent~=nil and carrying()==false
    end)
    nextPlace=os.clock()+1
    if not reached or not running or not placeRequested or disposed or root()~=hrp or ownedPlot()~=plot then return true end
    local character=player.Character
    local backpack=player:FindFirstChild("Backpack")
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if pack.Parent==backpack and humanoid then humanoid:EquipTool(pack);task.wait(.2) end
    if not placeRequested or disposed or root()~=hrp or ownedPlot()~=plot or pack.Parent~=character then return true end
    local id=pack:GetAttribute("PackId")
    if id==nil then return true end
    setStatus(placeStatusLabel,"Placing pack")
    local ok,result=invoke("Packs","PlaceOwned",{Position=position,PackId=id})
    if not ok or result==false then
        setStatus(placeStatusLabel,"Placement rejected")
        report("place",result)
        nextPlace=os.clock()+3
    else
        setStatus(placeStatusLabel,"Placement requested")
        nextPlace=os.clock()+2
    end
    return true
end
