    local node = part
    local inTreadmill = part.Name == "TreadmilBox"
    local owner
    while node and node ~= workspace do
        if node.Name == "PlayerTreadmill" or node.Name == "Treadmil" then inTreadmill = true end
        local value = node:GetAttribute("TreadmillOwnerUserId")
        if value ~= nil and owner == nil then owner = tonumber(value) end
        node = node.Parent
    end
    return inTreadmill and owner == player.UserId
end
local function resolveTreadmill()
    if ownedTreadmillPart(treadmillPart) then return treadmillPart end
    treadmillPart = nil
    local now = os.clock()
    if now < nextTreadmillSearch then return nil end
    nextTreadmillSearch = now + CONFIG.TreadmillSearchInterval
    local seats, boxes = {}, {}
    for _, object in ipairs(workspace:GetDescendants()) do
        if (object.Name == "Seat" or object.Name == "TreadmilBox") and ownedTreadmillPart(object) then
            local list = object.Name == "Seat" and seats or boxes
            table.insert(list, object)
        end
    end
    local candidates = #seats > 0 and seats or boxes
    if #candidates ~= 1 then
        if #candidates > 1 then report("treadmill_ambiguous", "Multiple owned treadmill targets; waiting for a unique target.") end
        return nil
    end
    treadmillPart = candidates[1]
    log("Owned treadmill found: " .. treadmillPart:GetFullName())
    return treadmillPart
end
local function treadmillDestination(part)
    local offset = part.Name == "Seat" and CONFIG.TreadmillSeatOffset or 0
    return CFrame.new(part.Position + Vector3.new(0, offset, 0))
end
local function treadmillCycle()
    local hrp = root()
    if not hrp then publishTreadmill("Waiting for character"); return end
    if hrp ~= treadmillRoot then
        treadmillRoot = hrp
        treadmillArrived = false
        treadmillArrivedAt = 0
        treadmillPart = nil
        treadmillTargetPart = nil
        nextTreadmillSearch = 0
    end
    if os.clock() < recoveryUntil then publishTreadmill("Movement paused"); return end
    if recoveryUntil > 0 then
        if not settleAfterDelivery(hrp) then return end
        recoveryUntil = 0
    end
    if isTraining() then
        if not treadmillArrived then treadmillArrivedAt = os.clock() end
        treadmillArrived = true
        if not boostEnabled then publishTreadmill("Training") end
        return
    end
    local state = carrying()
    if state == nil then publishTreadmill("Waiting for data"); return end
    if state == true then publishTreadmill("Finish carrying pack first"); return end
    local part = resolveTreadmill()
    if not part then
        treadmillArrived = false
        treadmillTargetPart = nil
        publishTreadmill("Finding your treadmill")
        return
    end
    if part ~= treadmillTargetPart then
        treadmillTargetPart = part
        treadmillArrived = false
        treadmillArrivedAt = 0
    end
    local target = treadmillDestination(part)
    local distance = (hrp.Position - target.Position).Magnitude
    if treadmillArrived and distance > CONFIG.TreadmillExitRadius then
        treadmillArrived = false
        treadmillArrivedAt = 0
    end
    if not treadmillArrived then
        if distance > CONFIG.TreadmillArrivalRadius then
            publishTreadmill("Moving to your treadmill")
            local reached = tweenTo(target, function()
                if not treadmillRequested or carrying() ~= false then return false, "state_changed" end
                if isTraining() then return false, "training_started" end
                if not ownedTreadmillPart(part) or (treadmillDestination(part).Position - target.Position).Magnitude > 2 then
                    return false, "target_changed"
                end
                if (hrp.Position - target.Position).Magnitude <= CONFIG.TreadmillArrivalRadius then return false, "in_range" end
                return true
            end)
            if not reached or not running or not treadmillRequested or root() ~= hrp then return end
        end
        if (hrp.Position - target.Position).Magnitude > CONFIG.TreadmillArrivalRadius then return end
        treadmillArrived = true
        treadmillArrivedAt = os.clock()
        log("Owned treadmill destination reached; waiting for native training.")
    end
    publishTreadmill("Waiting for training")
    if os.clock() - treadmillArrivedAt >= CONFIG.TreadmillSettleTime and distance > CONFIG.TreadmillArrivalRadius then
        treadmillArrived = false
    end
end
