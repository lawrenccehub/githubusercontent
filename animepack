local speedCurve = {{0,16},{10,18.8},{10000,36.27},{40000,64.25},{170000,84.97},{700000,101.55},{2500000,117.1},{18000000,134.72},{700000000,157.51},{2500000000,207.25},{10000000000,214},{100000000000,228},{1000000000000,250},{10000000000000,265},{100000000000000,280},{1000000000000000,295},{10000000000000000,310},{100000000000000000,325},{1000000000000000000,340}}
local speedUnits={K=1e3,M=1e6,B=1e9,T=1e12,QA=1e15,QI=1e18}
local function earnedSpeed()
    local stats=player:FindFirstChild("leaderstats")
    local stat=stats and stats:FindFirstChild("Speed")
    if not stat then return nil end
    local value=stat.Value
    local number=tonumber(value)
    if not number and type(value)=="string" then
        local cleaned=value:gsub("[,%s]",""):upper()
        local amount,unit=cleaned:match("^([%d%.]+)(%a+)$")
        number=tonumber(cleaned) or (tonumber(amount) and speedUnits[unit] and tonumber(amount)*speedUnits[unit])
    end
    if not number or number~=number or number<0 or number==math.huge then return nil end
    for i=1,#speedCurve-1 do
        local a,b=speedCurve[i],speedCurve[i+1]
        if number<=b[1] then return a[2]+(b[2]-a[2])*math.clamp((number-a[1])/(b[1]-a[1]),0,1) end
    end
    return 340
end
local function tweenTo(destination, onStep)
    local hrp = root()
    if not running or not hrp then return false, "interrupted" end
    local origin = hrp.CFrame
    local distance = (origin.Position - destination.Position).Magnitude
    if distance <= 0.25 then return true end
    local goal = CFrame.new(destination.Position) * origin.Rotation
    local earned = earnedSpeed()
    if not earned then
        report("speed", "Leaderboard Speed unavailable; waiting for player data.")
        return false, "speed_unavailable"
    end
    local rate = math.clamp(earned, CONFIG.MinTweenSpeed, CONFIG.MaxTweenSpeed)
    local duration = math.max(CONFIG.MinTweenDuration, distance / rate)
    local proxy = Instance.new("CFrameValue")
    proxy.Value = origin
    local tween = TweenService:Create(proxy, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Value = goal})
    activeTween = tween
    local lastWritten = origin.Position
    local deadline = os.clock() + duration + 5
    local function finish(ok, reason)
        if tween.PlaybackState ~= Enum.PlaybackState.Completed then tween:Cancel() end
        if activeTween == tween then activeTween = nil end
        proxy:Destroy()
        return ok, reason
    end
    tween:Play()
    while running and root() == hrp and os.clock() < deadline do
        local dt = MovementRunService.Heartbeat:Wait()
        if not running or root() ~= hrp or tween.PlaybackState == Enum.PlaybackState.Cancelled then
            return finish(false, "interrupted")
        end
        if onStep then
            local proceed, reason = onStep()
            if not proceed then return finish(reason == "in_range", reason or "state_changed") end
        end
        local actual = hrp.Position
        if (actual - lastWritten).Magnitude > CONFIG.MovementCorrectionTolerance then
            recoveryUntil = os.clock() + CONFIG.RecoveryDelay
            report("position_jump", "External position change detected; movement cancelled, no snap or correction applied.")
            return finish(false, "position_changed")
        end
        local delta = proxy.Value.Position - actual
        local maxStep = rate * math.clamp(dt or 0, 0, 0.10)
        if delta.Magnitude > maxStep and delta.Magnitude > 0 then
            delta = delta.Unit * maxStep
        end
        if delta.Magnitude > 0 then
            local nextPosition = actual + delta
            hrp.CFrame = CFrame.new(nextPosition) * origin.Rotation
            lastWritten = nextPosition
        else
            lastWritten = actual
        end
        if tween.PlaybackState == Enum.PlaybackState.Completed and (hrp.Position - goal.Position).Magnitude <= 0.25 then
            return finish(true)
        end
    end
    return finish(false, "interrupted")
end
