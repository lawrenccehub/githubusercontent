    if not gui then return end
    local chosen
    for _, layer in ipairs(gui:GetChildren()) do
        if layer.Name == "UI" then
            local prompt = layer:FindFirstChild("TAPTreadmillBoost")
            local detector = prompt and prompt:FindFirstChild("Detector")
            if detector and detector:IsA("GuiButton") and visibleBoostObject(detector, gui) then
