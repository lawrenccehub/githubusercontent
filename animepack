local function cycle()
    local hrp = root()
    if not hrp then publish("Waiting for character"); report("character", "Waiting for character."); return false end
    if os.clock() < recoveryUntil then publish("Movement paused - settling"); return false end
    if recoveryUntil > 0 then
        if not settleAfterDelivery(hrp) then return false end
        recoveryUntil = 0
    end
    local state = carrying()
    if state == nil then publish("Waiting for data"); report("state", "Replicated carrying state unavailable; no pickup attempted."); return false end
    if state then returnToSafeZone(); return false end
    if not waitForState(false, CONFIG.PickupTimeout, CONFIG.EmptyConfirmTime) then return false end
    local folder = stageFolder()
    watchPacks(folder)
    if not folder then
        publish("Waiting for stage")
        report("stage", "Not loaded: Workspace.Game.Packs.Stage" .. CONFIG.Stage .. ".SpawnedPacks")
        return false
    end
    if folder ~= lastFolder then lastFolder = folder; log("Stage resolved: " .. folder:GetFullName()) end
    local model, prompt = choosePack(folder, hrp)
    if not model then publish("Waiting for packs"); report("pack", "No available pack with enabled StealPrompt in selected stage."); return false end
    freshPacks[model] = nil
    local attempt = 0
    while running do
        attempt = attempt + 1
        if not running or root() ~= hrp or stageFolder() ~= folder then return false end
        state = carrying()
        if state == true then returnToSafeZone(); return true end
        if state ~= false then return false end
        if not model:IsDescendantOf(folder) then break end
        prompt = refreshPrompt(model, folder)
        if not prompt then
            if carrying() == true then returnToSafeZone(); return true end
            break
        end
        publish("Moving to pack")
        log("Moving to " .. model.Name .. " (attempt " .. attempt .. ")")
        local approached, reason = approach(prompt)
        if reason == "position_changed" then
            publish("Movement paused - position changed")
            return false
        end
        if not running or root() ~= hrp or stageFolder() ~= folder then return false end
        state = carrying()
        if state == true then returnToSafeZone(); return true end
        if state ~= false then return false end
        if approached and model:IsDescendantOf(folder) then
            local currentPrompt = getPrompt(model)
            if currentPrompt then
                publish("Picking up (attempt " .. attempt .. ")")
                log("Holding StealPrompt for " .. tostring(currentPrompt.HoldDuration) .. "s")
                if holdPrompt(currentPrompt) then returnToSafeZone(); return true end
            end
        end
        if not running or root() ~= hrp then return false end
        state = carrying()
        if state == true then returnToSafeZone(); return true end
        if state ~= false then return false end
        publish("Pickup retry " .. attempt)
        MovementRunService.Heartbeat:Wait()
    end
    if not running then return false end
    if carrying() == true then returnToSafeZone(); return true end
    if carrying() ~= false then return false end
    freshPacks[model] = nil
    publish("Checking next pack")
    report("pickup", "Target unavailable; checking other live packs.")
    return true
end
