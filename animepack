local function toggle(frame, fn)
    local state, busy = false, false
    local b = button(frame,"",UDim2.fromOffset(50,26),UDim2.new(1,-62,0.5,-13))
    b.BackgroundColor3=C.deep
    local outline=stroke(b,C.line,0.1)
