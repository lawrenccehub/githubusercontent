local function imageURI(value)
    if type(value)=="number" then
        if value>0 then return "rbxassetid://"..string.format("%.0f",value) end
    elseif type(value)=="string" then
        if value:match("^%d+$") and tonumber(value)>0 then return "rbxassetid://"..value end
        if value:match("^rbxassetid://%d+$") then return value end
        if value:match("^rbxasset://") then return value end
    end
    return nil
end
local imageRequests = setmetatable({}, {__mode="k"})
local ContentProvider = game:GetService("ContentProvider")
local function displayImage(image, fallback, uri, alternate, trustedLocal)
    if not uri then return end
    local request = (imageRequests[image] or 0) + 1
    imageRequests[image] = request
    local function valid()
        return alive and image.Parent and fallback.Parent and imageRequests[image] == request
    end
    if trustedLocal then
        local ok=pcall(function() image.Image=uri end)
        if ok then fallback.Visible=false; image.ImageTransparency=0 end
        return
    end
    local candidates={uri}
    if alternate and alternate~=uri then table.insert(candidates,alternate) end
    fallback.Visible=false
    image.ImageTransparency=0
    task.spawn(function()
        for _,candidate in ipairs(candidates) do
            if not valid() then return end
            local ok=pcall(function() image.Image=candidate end)
            if ok then
                local loaded=false
                task.spawn(function()
                    pcall(function()
                        ContentProvider:PreloadAsync({candidate},function(_,status)
                            if status==Enum.AssetFetchStatus.Success then loaded=true end
                        end)
                    end)
                end)
                local untilTime=os.clock()+5
                repeat
                    if not valid() then return end
                    if image.Image==candidate and (image.IsLoaded or loaded) then
                        fallback.Visible=false; image.ImageTransparency=0; return
                    end
                    task.wait(0.1)
                until os.clock()>=untilTime
            end
        end
        if valid() then
            fallback.Visible=true; image.ImageTransparency=1
            on(image:GetPropertyChangedSignal("IsLoaded"),function()
                if valid() and image.IsLoaded then
                    fallback.Visible=false; image.ImageTransparency=0
                end
            end)
            if image.IsLoaded then fallback.Visible=false; image.ImageTransparency=0 end
            warn("[AGONY UI] Image not confirmed loaded:",uri)
        end
    end)
end
