local function waitForState(expected, timeout, stableTime)
    local deadline = os.clock() + timeout
    local confirmedSince, confirmedId
    local hrp = root()
    repeat
        if not running or not hrp or root() ~= hrp then return false end
        local state, id = carrying()
        if state == expected then
            if not confirmedSince or confirmedId ~= id then
                confirmedSince, confirmedId = os.clock(), id
            end
            if os.clock() - confirmedSince >= (stableTime or 0) then return true, id end
        else
            confirmedSince, confirmedId = nil, nil
        end
        MovementRunService.Heartbeat:Wait()
    until os.clock() >= deadline
