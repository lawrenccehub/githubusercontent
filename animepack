    if not running or not hrp or not pos or not prompt.Enabled then return false end
    if (hrp.Position - pos).Magnitude > prompt.MaxActivationDistance then
        report("distance", "Outside prompt activation range after tween.")
        return false
    end
    local state = carrying()
    if state == true then return waitForState(true, CONFIG.PickupTimeout, CONFIG.CarryConfirmTime) end
    if state ~= false then return false end
    activePrompt = prompt
    local holdDuration = math.max(0, prompt.HoldDuration)
    local ok, err = pcall(function() prompt:InputHoldBegin() end)
    if not ok then
        releasePrompt()
        report("prompt", "Native prompt hold unavailable: " .. tostring(err))
        return false
    end
    local deadline = os.clock() + holdDuration + 0.25
    while running and root() == hrp and os.clock() < deadline do
        if carrying() == true then break end
        local currentPos = promptPosition(prompt)
        if not currentPos or not prompt.Enabled or (hrp.Position - currentPos).Magnitude > prompt.MaxActivationDistance then break end
        MovementRunService.Heartbeat:Wait()
    end
    releasePrompt()
    if not running or root() ~= hrp then return false end
    publish("Confirming pickup")
    return waitForState(true, CONFIG.PickupAckTimeout, CONFIG.CarryConfirmTime)
end
local function settleAfterDelivery(hrp)
    local start = os.clock()
    local last = hrp.Position
    local stableSince = start
    while running and root() == hrp do
        local now = os.clock()
        local current = hrp.Position
        if (current - last).Magnitude > 0.75 then
            stableSince = now
        end
        last = current
        if now - start >= CONFIG.DeliverySettleTime and now - stableSince >= CONFIG.DeliveryStableTime then
            return true
        end
        if now - start >= CONFIG.DeliverySettleTimeout then return false end
        MovementRunService.Heartbeat:Wait()
    end
    return false
end
local function returnToSafeZone()
    if not running then return end
    local confirmed, carryId = waitForState(true, CONFIG.PickupTimeout, CONFIG.CarryConfirmTime)
    if not confirmed then
        publish("Pickup not confirmed")
        return
    end
    local hrp = root()
    if not hrp then return end
    local decorations=workspace:FindFirstChild("Decorations")
    local folder=decorations and decorations:FindFirstChild("Idk")
    local safe=folder and folder:FindFirstChild("SafeZone")
    local target=(safe and safe:IsA("BasePart") and safe.CFrame*CFrame.new(0,0,5) or CONFIG.SafeZone)+Vector3.new(0,CONFIG.SafeZoneHeightOffset,0)
    publish("Returning to SafeZone")
    log("Carrying confirmed; returning to SafeZone")
    local clearedDistance
    local function observeCarry()
        if root() ~= hrp then return false, "interrupted" end
        local state, id = carrying()
        if state == false then
            clearedDistance = (hrp.Position - target.Position).Magnitude
            return false, "carry_cleared"
        end
        if state ~= true or id ~= carryId then return false, "state_changed" end
        return true
    end
    if (hrp.Position - target.Position).Magnitude > CONFIG.MoveTolerance then
        local reached, reason = tweenTo(target, observeCarry)
        if not running or root() ~= hrp then return end
        if not reached and reason ~= "carry_cleared" then
            publish("Return incomplete")
            report("position", "Return movement interrupted; no final position snap applied.")
            return
        end
    end
    if clearedDistance == nil then
        publish("Waiting at SafeZone")
        if not waitForState(false, CONFIG.ReturnTimeout) then
            report("return", "Carrying state did not clear; no forced position correction.")
            return
        end
        if not running or root() ~= hrp then return end
        clearedDistance = (hrp.Position - target.Position).Magnitude
    end
    if clearedDistance <= CONFIG.ArrivalTolerance then
        publish("Delivery settling")
        log("Carry cleared near SafeZone; return movement stopped.")
    else
        publish("Carry ended - settling")
        report("carry_ended", "Carry cleared " .. string.format("%.1f", clearedDistance) .. " studs from target; delivery not verified.")
    end
    if not settleAfterDelivery(hrp) then
        if running then publish("Position settling - retry later") end
        return
    end
    if not running then return end
    publish(clearedDistance <= CONFIG.ArrivalTolerance and "SafeZone reached" or "Carry ended")
end
