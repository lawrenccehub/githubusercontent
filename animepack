end
local function approach(prompt)
    local hrp, pos = root(), promptPosition(prompt)
    if not hrp or not pos then return false end
    local offset = hrp.Position - pos
    local horizontal = Vector3.new(offset.X, 0, offset.Z)
    if horizontal.Magnitude < 0.01 then horizontal = Vector3.new(0, 0, 1) end
    local distance = math.min(CONFIG.PickupDistance, math.max(0.5, prompt.MaxActivationDistance * 0.5))
    local target = pos + horizontal.Unit * distance
    if offset.Magnitude <= math.min(prompt.MaxActivationDistance * 0.8, distance + 2) then return true end
    return tweenTo(CFrame.new(target), function()
        if carrying() ~= false then return false, "state_changed" end
        local currentPos = promptPosition(prompt)
        if not currentPos or not prompt.Enabled then return false, "target_changed" end
        if (hrp.Position - currentPos).Magnitude <= math.min(prompt.MaxActivationDistance * 0.8, distance + 2) then
            return false, "in_range"
        end
        return true
    end)
end
local function holdPrompt(prompt)
