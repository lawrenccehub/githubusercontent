    local stateText=label(frame,"OFF",UDim2.fromOffset(35,26),UDim2.new(1,-103,0.5,-13),10)
    stateText.TextColor3=C.muted
    local function paint(v)
        stateText.Text=v and "ON" or "OFF"
        stateText.TextColor3=v and C.red or C.muted
        animate(b,{BackgroundColor3=v and C.selected or C.deep})
        animate(knob,{Position=UDim2.fromOffset(v and 28 or 4,4),BackgroundColor3=v and C.red or C.muted})
        animate(outline,{Color=v and C.red or C.line})
    end
    local function set(v)
        v=v==true
        if busy or v==state then return end
        busy=true
        state=v
        paint(v)
        local ok,err=pcall(fn,v)
        if not ok then warn("[AGONY TOGGLE]",err); state=not v; paint(state) end
        busy=false
    end
    on(b.Activated,function() set(not state) end)
    return set
end
