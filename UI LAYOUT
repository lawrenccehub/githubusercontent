    if cameraConnection then cameraConnection:Disconnect() end
    local camera = workspace.CurrentCamera
    if camera then cameraConnection = on(camera:GetPropertyChangedSignal("ViewportSize"), resize) end
    resize()
end
on(workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)
bindCamera()
local function call(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then warn("[AGONY UI]", err) end
end
local function pageFor(name)
    assert(alive, "UI destroyed")
    return assert(pages[name], "Unknown tab: " .. tostring(name))
end
function Hub:Toggle(tab, name, default, callback)
    local set = toggle(card(pageFor(tab), name), callback or function() end)
    if default == true then set(true) end
    return set
end
function Hub:Button(tab, name, text, callback)
    local b = rightButton(card(pageFor(tab), name), text or "RUN")
    on(b.Activated, function() call(callback) end)
    return b
end
function Hub:Dropdown(tab, name, values, default, callback)
    local entries = {}
    for _, value in ipairs(values) do
        table.insert(entries, {label = tostring(value), value = value})
    end
    local selected = default or values[1]
    local b = rightButton(card(pageFor(tab), name), tostring(selected or "SELECT"))
    dropdown(b, entries, function(value, text)
        selected = value
        b.Text = text
        call(callback, value)
    end)
    return function() return selected end
end
function Hub:Textbox(tab, name, placeholder, default, callback)
    local box = rounded(ui("TextBox", card(pageFor(tab), name), {
        Size = UDim2.fromOffset(150, 30),
        Position = UDim2.new(1, -161, 0.5, -15),
        BackgroundColor3 = C.side, BorderSizePixel = 0,
        TextColor3 = C.white, PlaceholderText = placeholder or "Enter text",
        Text = tostring(default or ""), ClearTextOnFocus = false,
        Font = Enum.Font.Gotham, TextSize = 10
    }), 8)
    on(box.FocusLost, function(enterPressed) call(callback, box.Text, enterPressed) end)
    return box
end
function Hub:Label(tab, name, value)
    local t = status(pageFor(tab), name)
    t.Text = tostring(value or "")
    return t
end
function Hub:Section(tab, name)
    local f=ui("Frame",pageFor(tab),{Size=UDim2.new(1,-5,0,29),BackgroundTransparency=1})
    local t=label(f,"//  "..name,UDim2.new(1,-12,1,0),UDim2.fromOffset(8,0),12)
    t.TextColor3=C.red
    return t
end
function Hub:ShowTab(name) showPage(name) end
function Hub:SetVisible(value)
    if not alive then return end
    if float.Visible then window.Visible = value == true end
end
function Hub:Destroy()
    if not alive then return end
    alive = false
    for _, connection in ipairs(conns) do connection:Disconnect() end
    screen:Destroy()
    floating:Destroy()
end
-- Live dashboard; metrics are local and no network requests are sent.
function Hub:Dashboard(tab)
    local page=pageFor(tab)
    local hero=rounded(ui("Frame",page,{Size=UDim2.new(1,-5,0,110),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ClipsDescendants=true}),12)
    gradient(hero,Color3.fromRGB(79,19,34),Color3.fromRGB(25,16,24),18)
    stroke(hero,C.red,0.35)
    for i=1,4 do
        rounded(ui("Frame",hero,{Size=UDim2.fromOffset(33,190),Position=UDim2.new(1,-12-i*36,0,-35),Rotation=28,BackgroundColor3=C.red,BackgroundTransparency=0.88,BorderSizePixel=0}),4)
    end
    local word=label(hero,"A G O N Y  /  C R I M S O N",UDim2.new(1,-24,0,17),UDim2.fromOffset(15,11),10)
    word.TextColor3=C.red
    local welcome=label(hero,"Welcome, "..player.DisplayName,UDim2.new(1,-32,0,35),UDim2.fromOffset(15,29),23)
    welcome.TextTruncate=Enum.TextTruncate.AtEnd
    local tagline=label(hero,options.GameName or "Universal control center",UDim2.new(1,-32,0,22),UDim2.fromOffset(16,66),12)
    tagline.TextColor3=C.muted
    local marker=ui("Frame",hero,{Size=UDim2.fromOffset(72,3),Position=UDim2.fromOffset(16,96),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0})
    gradient(marker,C.red,C.amber)
    Hub:Section(tab,"LIVE TELEMETRY")
    local metrics=ui("Frame",page,{Size=UDim2.new(1,-5,0,86),BackgroundTransparency=1})
    ui("UIListLayout",metrics,{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder})
    local function metric(index,name,caption,color)
        local f=rounded(ui("Frame",metrics,{Size=UDim2.new(0.25,-6,1,0),LayoutOrder=index,BackgroundColor3=C.card,BorderSizePixel=0}),10)
        stroke(f,color,0.55)
        local t=label(f,name,UDim2.new(1,-16,0,20),UDim2.fromOffset(10,6),10);t.TextColor3=C.muted
        local val=label(f,"--",UDim2.new(1,-16,0,30),UDim2.fromOffset(10,26),21);val.TextColor3=color;val.TextTruncate=Enum.TextTruncate.AtEnd
        local foot=label(f,caption,UDim2.new(1,-16,0,16),UDim2.fromOffset(10,59),10);foot.TextColor3=C.muted
        return val
    end
    local fps=metric(1,"FRAME RATE","FPS",C.red)
    local ping=metric(2,"LATENCY","milliseconds",C.amber)
    local count=metric(3,"SERVER","players",C.green)
    local elapsed=metric(4,"SESSION","hub uptime",C.white)
    Hub:Section(tab,"QUICK NAVIGATION")
    local quick=ui("Frame",page,{Size=UDim2.new(1,-5,0,math.max(34,math.ceil(math.min(#names-1,4)/2)*40-6)),BackgroundTransparency=1})
    ui("UIGridLayout",quick,{CellSize=UDim2.new(0.5,-4,0,34),CellPadding=UDim2.fromOffset(8,6),SortOrder=Enum.SortOrder.LayoutOrder})
    local added=0
    for _, name in ipairs(names) do
        if name~=tab and added<4 then
            added = added + 1
            local b=button(quick,name.."  >",UDim2.new());b.LayoutOrder=added;stroke(b,C.line,0.25)
            on(b.Activated,function() showPage(name) end)
        end
    end
    local frames, seconds, started=0,0,os.clock()
    on(Run.RenderStepped,function(dt)
        frames = frames + 1;seconds = seconds + dt
        if seconds<1 then return end
        local currentFPS=math.floor(frames/seconds+0.5);frames,seconds=0,0
        if not window.Visible or not page.Visible then return end
        fps.Text=tostring(currentFPS)
        fps.TextColor3=currentFPS>=50 and C.green or (currentFPS>=30 and C.amber or C.red)
        local ok,ms=pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        ping.Text=ok and type(ms)=="number" and tostring(math.floor(ms+0.5)) or "N/A"
        count.Text=tostring(#Players:GetPlayers()).."/"..tostring(Players.MaxPlayers)
        local t=math.floor(os.clock()-started)
        elapsed.Text=string.format("%02d:%02d",math.floor(t/60),t%60)
    end)
end
Hub.Pages = pages
Hub.Theme = C
local duration = math.max(0, tonumber(options.LoadingTime) or 10)
local started = os.clock()
local function finish()
    if not alive then return end
    loading:Destroy()
    float.Visible = true
    if options.OpenOnLoad then window.Visible = true end
end
if duration == 0 then
    finish()
else
    task.spawn(function()
        while alive do
            local progress = math.clamp((os.clock() - started) / duration, 0, 1)
            barFill.Size = UDim2.fromScale(progress, 1)
            barLabel.Text = "Loading... " .. tostring(math.floor(progress * 100)) .. "%"
            if progress >= 1 then break end
            task.wait(0.05)
        end
        if alive then finish() end
    end)
end
return Hub
end
