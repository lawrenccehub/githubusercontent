    linkBox.Visible=valid
    copyButton.Visible=valid
    openButton.Visible=valid
    openButton.Text=canOpen and "OPEN LINK" or "OPEN UNAVAILABLE"
    openButton.Active=canOpen
    openButton.Selectable=canOpen
    openButton.TextColor3=canOpen and C.white or C.muted
