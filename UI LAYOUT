local function draggable(target, handle, scaled)
local moving = false
local inputRef
local start
local origin
local moved = false
on(handle.InputBegan, function(input)
if input.UserInputType ==
Enum.UserInputType.MouseButton1
or input.UserInputType ==
Enum.UserInputType.Touch then
moving = true
inputRef = input
start = input.Position
origin = target.Position
moved = false
end
end)
on(UIS.InputChanged, function(input)
if not moving or not start then
return
end
if input.UserInputType ~=
Enum.UserInputType.MouseMovement
and input ~= inputRef then
return
end
local d = input.Position - start
if d.Magnitude > 6 then
moved = true
end
local f = scaled and scale.Scale or 1
target.Position = UDim2.new(
origin.X.Scale,
origin.X.Offset + d.X / f,
origin.Y.Scale,
origin.Y.Offset + d.Y / f
)
end)
on(UIS.InputEnded, function(input)
if input == inputRef or (inputRef and input.UserInputType == Enum.UserInputType.MouseButton1 and inputRef.UserInputType == Enum.UserInputType.MouseButton1) then
moving = false
inputRef = nil
end
end)
return function()
return moved
end
end
