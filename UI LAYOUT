local factor = scale.Scale
if factor <= 0 then return end
local p = anchor.AbsolutePosition - content.AbsolutePosition
local width, height = content.AbsoluteSize.X / factor, content.AbsoluteSize.Y / factor
local top, bottom = 76, height - 8
local page = anchor:FindFirstAncestorWhichIsA("ScrollingFrame")
if page and page:IsDescendantOf(content) then
    local offset = (page.AbsolutePosition.Y - content.AbsolutePosition.Y) / factor
    top = math.max(top, offset)
    bottom = math.min(bottom, offset + page.AbsoluteSize.Y / factor)
end
local aTop, aBottom = p.Y / factor, (p.Y + anchor.AbsoluteSize.Y) / factor
if aBottom <= top or aTop >= bottom then return end
local below, above = math.max(0, bottom-aBottom), math.max(0, aTop-top)
local useBelow = below >= h or below >= above
local available = useBelow and below or above
local actualH = math.min(h, math.max(0, available))
if actualH < 36 then return end
local x = math.clamp(p.X/factor, 0, math.max(0,width-165-6))
local y = useBelow and aBottom or aTop-actualH
m.Size = UDim2.fromOffset(165, actualH)
m.Position = UDim2.fromOffset(x, math.clamp(y,top,math.max(top,bottom-actualH)))
m.CanvasPosition = Vector2.zero
m.Visible = true
end)
return optionButtons
end
