local function showLink(name,url)
    currentLink=type(url)=="string" and url or ""
    local valid=currentLink:match("^https://%S+$")~=nil
    if not valid then currentLink="" end
    linkHeading.Text=name
    linkHelp.Text=valid and "Copy this link and open it in your browser or app." or "Community link not configured yet."
    linkBox.Text=currentLink
    linkBox.Visible=valid
    copyButton.Visible=valid
    copyButton.Text="COPY LINK"
    linkOverlay.Visible=true
end
on(copyButton.Activated,function()
    if currentLink=="" then return end
    if type(setclipboard)=="function" then
        local ok=pcall(setclipboard,currentLink)
        if ok then copyButton.Text="COPIED";return end
    end
    -- Standard Roblox client: show the URL for manual copying instead.
    linkBox.TextEditable=true
    linkBox:CaptureFocus()
    linkBox.CursorPosition=#currentLink+1
    linkBox.SelectionStart=1
    linkHelp.Text="Copy the selected link, then open it in your browser or app."
end)
