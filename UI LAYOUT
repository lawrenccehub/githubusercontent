    local glowAccum = 0
    on(Run.Heartbeat, function(dt)
        if not alive then return end
        glowClock = glowClock + dt
        glowAccum = glowAccum + dt
        if glowAccum < 0.075 then return end
        glowAccum = 0
        local pulse = (math.sin(glowClock * 3) + 1) * 0.5
        local color = Color3.fromRGB(255,
            math.floor(35 + 65 * pulse),
            math.floor(48 + 65 * pulse))
        local transparency = 0.08 + 0.62 * (1 - pulse)
        if title.Parent then
            title.TextColor3 = color
            titleGlow.Transparency = transparency
            shellStroke.Transparency = 0.24 + 0.32 * (1-pulse)
        end
        if loadTitle.Parent and loading.Parent then
            loadTitle.TextColor3 = color
            loadGlow.Transparency = transparency
        end
    end)
end

