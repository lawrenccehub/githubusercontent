-- Drag works with mouse and touch; pressing floating AG toggles window.
local function draggable(target, handle, clickFunction)
    local dragging, startPos, initialPos, activeInput, moved = false, nil, nil, nil, false
    connect(handle.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            activeInput = input
            startPos = input.Position
            initialPos = target.Position
        end
    end)
    connect(UIS.InputChanged, function(input)
        if not dragging then return end
        if input == activeInput or (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - startPos
            if delta.Magnitude > 6 then moved = true end
            target.Position = UDim2.new(initialPos.X.Scale, initialPos.X.Offset + delta.X,
                initialPos.Y.Scale, initialPos.Y.Offset + delta.Y)
        end
    end)
    connect(UIS.InputEnded, function(input)
        if not dragging then return end
        if input == activeInput or (activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
            dragging = false
            activeInput = nil
            if clickFunction and not moved then clickFunction() end
        end
    end)
end
