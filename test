-- Standalone local-only test. No external requests or farming features.
-- Freeze affects the local client's view / locally simulated objects only.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local global = (type(getgenv) == "function" and getgenv()) or _G

-- Remove only this test's previous instance when re-executed.
if type(global.AGONY_VULN_CLEANUP) == "function" then
    pcall(global.AGONY_VULN_CLEANUP)
end

local old = playerGui:FindFirstChild("AgonyVulnFreezeTest")
if old then old:Destroy() end

local frozen = false
local active = true
local savedParts = {}
local addedConnection
local cameraConnection
local fixedCamera
local oldCameraType
local oldCameraSubject

local function freezePart(part)
    if not part:IsA("BasePart") or savedParts[part] then return end
    savedParts[part] = {
        anchored = part.Anchored,
        linear = part.AssemblyLinearVelocity,
        angular = part.AssemblyAngularVelocity,
    }
    pcall(function()
        part.Anchored = true
        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function stopFreeze()
    frozen = false
    if addedConnection then addedConnection:Disconnect(); addedConnection = nil end
    if cameraConnection then cameraConnection:Disconnect(); cameraConnection = nil end
    local camera = workspace.CurrentCamera
    if camera then
        pcall(function()
            camera.CameraType = oldCameraType or Enum.CameraType.Custom
            if oldCameraSubject and oldCameraSubject.Parent then camera.CameraSubject = oldCameraSubject end
        end)
    end
    -- Restore original anchor state. Do not restore old velocities: it can
    -- violently launch character/physics parts after a long pause.
    for part, state in pairs(savedParts) do
        if part and part.Parent then
            pcall(function() part.Anchored = state.anchored end)
        end
        savedParts[part] = nil
    end
end

local function startFreeze()
    if frozen then return end
    frozen = true
    local camera = workspace.CurrentCamera
    if camera then
        oldCameraType = camera.CameraType
        oldCameraSubject = camera.CameraSubject
        fixedCamera = camera.CFrame
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = fixedCamera
        cameraConnection = RunService.RenderStepped:Connect(function()
            if frozen and camera.Parent then camera.CFrame = fixedCamera end
        end)
    end
    for _, instance in ipairs(workspace:GetDescendants()) do
        if not frozen then break end
        if instance:IsA("BasePart") then freezePart(instance) end
    end
    addedConnection = workspace.DescendantAdded:Connect(function(instance)
        if frozen and instance:IsA("BasePart") then freezePart(instance) end
    end)
end

