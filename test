-- Lightweight visual freeze: lock local camera and local movement controls.
-- IMPORTANT: don't anchor workspace, run infinite loops or flood remotes.
local camera, oldType, oldSubject, oldCF, cameraConn, controls
local oldWalkSpeed, oldJumpPower, oldJumpHeight, oldAutoRotate
local frozenHum
local function releaseFreeze()
    frozen = false
    if cameraConn then cameraConn:Disconnect(); cameraConn = nil end
    if camera and camera.Parent then
        pcall(function()
            camera.CameraType = oldType or Enum.CameraType.Custom
            if oldSubject and oldSubject.Parent then camera.CameraSubject = oldSubject end
        end)
    end
    if frozenHum and frozenHum.Parent then
        pcall(function()
            frozenHum.WalkSpeed = oldWalkSpeed or 16
            if oldJumpPower ~= nil then frozenHum.JumpPower = oldJumpPower end
            if oldJumpHeight ~= nil then frozenHum.JumpHeight = oldJumpHeight end
            if oldAutoRotate ~= nil then frozenHum.AutoRotate = oldAutoRotate end
        end)
    end
    if controls then pcall(function() controls:Enable() end) end
    frozenHum, controls, camera, oldSubject = nil, nil, nil, nil
end
local function engageFreeze()
    if frozen then return end
    frozen = true
    camera = workspace.CurrentCamera
    if camera then
        oldType, oldSubject, oldCF = camera.CameraType, camera.CameraSubject, camera.CFrame
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = oldCF
        cameraConn = connect(RunService.RenderStepped, function()
            if frozen and camera and camera.Parent then camera.CFrame = oldCF end
        end)
    end
    local character = player.Character
    frozenHum = character and character:FindFirstChildOfClass("Humanoid")
    if frozenHum then
        oldWalkSpeed, oldJumpPower, oldJumpHeight, oldAutoRotate = frozenHum.WalkSpeed,
            frozenHum.JumpPower, frozenHum.JumpHeight, frozenHum.AutoRotate
        frozenHum.WalkSpeed = 0
        frozenHum.JumpPower = 0
        frozenHum.JumpHeight = 0
        frozenHum.AutoRotate = false
    end
    pcall(function()
        local scripts = player:FindFirstChild("PlayerScripts")
        local module = scripts and scripts:FindFirstChild("PlayerModule")
        if module then
            controls = require(module):GetControls()
            controls:Disable()
        end
    end)
end

