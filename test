local function syncToggle()
    toggle.Text = frozen and "ON" or "OFF"
    toggle.BackgroundColor3 = frozen and Color3.fromRGB(32, 157, 105) or Color3.fromRGB(169, 55, 69)
end

toggle.MouseButton1Click:Connect(function()
    if not active then return end
    if frozen then stopFreeze() else startFreeze() end
    syncToggle()
end)

-- Drag by the title area, with mouse or touchscreen.
local dragging = false
local dragStart, originalPosition
local dragInput
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        originalPosition = main.Position
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(originalPosition.X.Scale, originalPosition.X.Offset + delta.X,
            originalPosition.Y.Scale, originalPosition.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input == dragInput or (dragging and input.UserInputType == Enum.UserInputType.MouseButton1) then
        dragging = false
    end
end)

local function cleanup()
    if not active then return end
    active = false
    stopFreeze()
    if gui.Parent then gui:Destroy() end
end
global.AGONY_VULN_CLEANUP = cleanup
close.MouseButton1Click:Connect(cleanup)
